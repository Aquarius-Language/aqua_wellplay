##
畫面：上方的工具列、左邊的檔案瀏覽器、筆記本分頁、儲存格（編輯器與輸出）、啟動頁、狀態列、提示訊息與對話框。全部是
SaturnUI 小工具，依應用程式的狀態（app.aqua）建立。
The screen: the top bar, the file browser on the left, notebook tabs, cells (editors and outputs), the launcher, the
status bar, toasts and dialogs. All SaturnUI widgets built from the app's state (app.aqua).
##
var UI = import("SaturnUI");

struct Modules { app; editors; outputs; theme }
var M = null;
var Initialize = function(modules) { M = modules; return null; };

var icon = (name, size = 16, color = null) => UI.Icon(name, size: size, color: color);
var tip = (message, child) => UI.Tooltip(message: message, child: child);

# 工具列的按鈕。 / A toolbar button.
var Tool = function(name, label, onTap, variant = null, hint = "") {
    var button = UI.Box(class: if (variant == null) { "tool"; } else { "tool " + variant; }, onTap: onTap, children: [
        icon(name, 15),
        if (label != "") UI.Text(label),
    ]);
    if (hint == "") { return button; }
    return tip(hint, button);
};

# ---- 上方 / The top bar ----
var KernelPill = function(app, doc, t) {
    if (app.status != "online") {
        var color = if (app.status == "connecting") { t.warning; } else { t.danger; };
        return UI.Row(class: "pill", children: [UI.Box(class: "dot", style: {"background": color}),
            UI.Text(if (app.status == "connecting") { "Connecting · 連線中"; } else { "Offline · 離線"; })]);
    }
    if (doc == null) { return UI.Row(class: "pill", children: [UI.Box(class: "dot", style: {"background": t.success}), UI.Text("Connected · 已連線")]); }
    var state = Hash.Get(doc.kernel, "state", "idle");
    var busy = state == "busy";
    var pulse = 0.55d + 0.45d * import("Processing").sin(currentTime() / 180.0d);
    return UI.Row(class: "pill", children: [
        UI.Box(class: "dot", style: {"background": if (busy) { t.warning; } else { t.success; }, "opacity": if (busy) { pulse; } else { 1; }}),
        UI.Text(if (busy) { "Running · 執行中"; } else { "Kernel idle · 核心閒置"; }),
        UI.Text("AquariusLang", style: {"color": t.faint}),
    ]);
};

var TopBar = function(app, t) {
    var doc = M.app.ActiveDoc(app);
    var tools = if (doc == null) { null; } else { UI.Row(class: "toolbar", children: [
        Tool("save", "", () => M.app.Save(app, doc), null, "Save · 儲存 (Ctrl+S)"),
        Tool("plus", "Code", () => M.app.Insert(app, doc, doc.selected + 1, "code"), null, "Insert a code cell below · 插入程式碼儲存格 (B)"),
        Tool("text", "Text", () => M.app.Insert(app, doc, doc.selected + 1, "markdown"), null, "Insert a Markdown cell below · 插入文字儲存格"),
        UI.Box(style: {"width": 1, "height": 20, "background": t.border, "marginHorizontal": 4}),
        Tool("play", "Run", () => runSelected(app, doc, true), "primary", "Run the cell and select the next · 執行 (Shift+Enter)"),
        Tool("fastForward", "Run all", () => M.app.Run(app, doc, M.app.RunAll(doc)), null, "Run every cell · 全部執行"),
        Tool("stop", "", () => M.app.Interrupt(app, doc), "danger", "Interrupt · 中斷 (I, I)"),
        Tool("refresh", "", () => { app.dialog = {"kind": "restart"}; }, null, "Restart the kernel · 重新啟動核心 (0, 0)"),
        Tool("close", "", () => M.app.ClearOutputs(app, doc), null, "Clear all outputs · 清除所有輸出"),
    ]); };
    return UI.Row(class: "topbar", children: [
        tip("Files · 檔案 (Ctrl+B)", UI.Box(class: "tool", onTap: () => { app.sidebar = !app.sidebar; }, child: icon("menu", 17))),
        UI.Box(class: "brandMark", child: UI.Text("W", style: {"color": "#ffffff", "fontWeight": 900, "fontSize": 16})),
        UI.Column(gap: 0, children: [UI.Text("WellPlay", class: "brand"), UI.Text("AquariusLang notebooks · 星泉筆記本", class: "brandSub")]),
        UI.Box(style: {"width": 12}),
        tools,
        UI.Spacer(),
        KernelPill(app, doc, t),
        tip(if (app.dark) { "Light theme · 淺色"; } else { "Dark theme · 深色"; },
            UI.Box(class: "tool", onTap: () => M.app.ToggleTheme(app), child: icon(if (app.dark) { "sun"; } else { "moon"; }, 17))),
    ]);
};

# ---- 檔案 / Files ----
var Breadcrumbs = function(app, t) {
    var parts = if (app.dir == "") { []; } else { String.Split(app.dir, "/"); };
    var root = if (app.info == null) { "Home"; } else { app.info["rootName"]; };
    var crumbs = [UI.Box(class: "crumb", onTap: () => M.app.ListFiles(app, ""), child: UI.Row(gap: 4, crossAxis: "center", children: [icon("home", 13), UI.Text(root)]))];
    for (var i = 0; i < len(parts); i++) {
        var target = String.Join(Array.Slice(parts, 0, i + 1), "/");
        Array.Append(crumbs, UI.Text("/", style: {"color": t.faint}));
        Array.Append(crumbs, UI.Box(class: "crumb", onTap: () => M.app.ListFiles(app, target), child: UI.Text(parts[i])));
    }
    return UI.Row(class: "crumbs", children: crumbs);
};
var size = function(bytes) {
    if (bytes < 1024) { return String.From(bytes) + " B"; }
    if (bytes < 1048576) { return String.From(int(bytes / 1024)) + " KB"; }
    return String.From(int(bytes / 1048576)) + " MB";
};
var FileRow = function(app, entry, t) {
    var kind = entry["kind"];
    var name = if (kind == "directory") { "folder"; } elif (kind == "notebook") { "notebook"; } elif (kind == "script") { "code"; } else { "file"; };
    var color = if (kind == "directory") { t.warning; } elif (kind == "notebook") { t.primary; } elif (kind == "script") { t.accent; } else { t.faint; };
    var doc = M.app.ActiveDoc(app);
    var active = doc != null && doc.path == entry["path"];
    var open = function() {
        if (kind == "directory") { M.app.ListFiles(app, entry["path"]); }
        elif (kind == "notebook") { M.app.Open(app, entry["path"]); }
        else { M.app.Toast(app, "Only notebooks open here · 只能開啟筆記本"); }
        return null;
    };
    return UI.Box(class: if (active) { "fileRow active"; } else { "fileRow"; }, key: entry["path"], onTap: open, children: [
        icon(name, 16, color),
        UI.Expanded(child: UI.Text(entry["name"], maxLines: 1, ellipsis: true)),
        if (kind != "directory") UI.Text(size(entry["size"]), class: "fileMeta"),
        UI.Box(class: "miniTool", onTap: () => { app.dialog = {"kind": "rename", "path": entry["path"], "value": entry["name"]}; }, child: icon("edit", 13)),
        UI.Box(class: "miniTool", onTap: () => { app.dialog = {"kind": "delete", "path": entry["path"], "value": entry["name"]}; }, child: icon("trash", 13)),
    ]);
};
var Sidebar = function(app, t) {
    var files = app.files;
    return UI.Column(class: "sidebar", crossAxis: "stretch", children: [
        UI.Row(crossAxis: "center", children: [
            UI.Text("FILES · 檔案", class: "sideTitle"), UI.Spacer(),
            tip("New notebook · 新筆記本", UI.Box(class: "miniTool", onTap: () => M.app.NewNotebook(app), child: icon("plus", 15))),
            tip("New folder · 新資料夾", UI.Box(class: "miniTool", onTap: () => { app.dialog = {"kind": "folder", "value": ""}; }, child: icon("folder", 15))),
            tip("Refresh · 重新整理", UI.Box(class: "miniTool", onTap: () => M.app.ListFiles(app, app.dir), child: icon("refresh", 15))),
        ]),
        Breadcrumbs(app, t),
        UI.ScrollView(style: {"flexGrow": 1, "flexBasis": 0}, child: UI.Column(gap: 2, crossAxis: "stretch", children: [
            if (app.dir != "") UI.Box(class: "fileRow", onTap: () => {
                var parts = String.Split(app.dir, "/");
                M.app.ListFiles(app, String.Join(Array.Slice(parts, 0, len(parts) - 1), "/"));
            }, children: [icon("arrowLeft", 15, t.faint), UI.Text("..", style: {"color": t.muted})]),
            for (var i = 0; i < len(files); i++) FileRow(app, files[i], t),
            if (len(files) == 0) UI.Text("This folder is empty · 這個資料夾是空的", style: {"color": t.faint, "fontSize": 12, "padding": 8}),
        ])),
        UI.Box(class: "ghost", onTap: () => M.app.NewNotebook(app), style: {"justifyContent": "center"}, children: [icon("notebook", 14), UI.Text("New notebook · 新筆記本")]),
    ]);
};

# ---- 分頁 / Tabs ----
var Tabs = function(app, t) {
    var tabs = [];
    for (var i = 0; i < len(app.docs); i++) {
        var doc = app.docs[i];
        var index = i;
        Array.Append(tabs, UI.Box(class: if (i == app.active) { "tab active"; } else { "tab"; }, key: doc.path, onTap: () => { app.active = index; }, children: [
            icon("notebook", 14, if (i == app.active) { t.primary; } else { t.faint; }),
            UI.Text(doc.name, maxLines: 1, ellipsis: true),
            if (doc.dirty) UI.Box(class: "dot", style: {"background": t.accent, "width": 7, "height": 7}),
            UI.Box(class: "tabClose", onTap: () => M.app.Close(app, index), child: icon("close", 11)),
        ]));
    }
    var home = UI.Box(class: if (app.active < 0) { "tab active"; } else { "tab"; }, key: "launcher", onTap: () => { app.active = -1; },
        children: [icon("home", 14), UI.Text("Launcher")]);
    return UI.Row(class: "tabs", children: [home, ...tabs]);
};

# ---- 儲存格 / Cells ----
var runSelected = function(app, doc, advance) {
    var index = doc.selected;
    M.app.Run(app, doc, [index]);
    if (advance) {
        if (index + 1 >= len(doc.notebook["cells"])) { M.app.Insert(app, doc, index + 1, "code"); }
        M.app.Select(app, doc, index + 1);
        if (doc.editing != null) { FocusCell(app, doc, doc.selected); }
    }
    return null;
};

var Prompt = function(app, doc, cell, t) {
    var status = doc.status[cell["id"]];
    var count = cell["execution_count"];
    var text = if (status == "running") { "[*]"; } elif (status == "queued") { "[…]"; } elif (count == null) { "[ ]"; } else { "[" + String.From(count) + "]"; };
    var errored = false;
    var outputs = cell["outputs"];
    for (var i = 0; i < len(outputs); i++) { if (outputs[i]["output_type"] == "error") { errored = true; } }
    var cls = if (status != null) { "prompt running"; } elif (errored) { "prompt error"; } else { "prompt"; };
    var ms = doc.durations[cell["id"]];
    return UI.Column(class: cls, gap: 4, children: [
        UI.Box(class: "miniTool", onTap: () => M.app.Run(app, doc, [Array.Index(doc.notebook["cells"], cell)]),
            child: icon(if (status == "running") { "dot"; } else { "play"; }, 13, if (status != null) { t.primary; } else { t.faint; })),
        UI.Text(text),
        if (ms != null && status == null && count != null) UI.Text(if (ms < 1000) { String.From(ms) + "ms"; } else { String.From(ms / 1000) + "." + String.From((ms % 1000) / 100) + "s"; },
            style: {"fontSize": 10, "color": t.faint}),
    ]);
};

var CellTools = function(app, doc, index, cell, t) {
    var type = cell["cell_type"];
    var mini = (name, hint, action) => tip(hint, UI.Box(class: "miniTool", onTap: action, child: icon(name, 14)));
    return UI.Row(class: "cellTools", children: [
        mini("chevronUp", "Move up · 上移", () => M.app.Move(app, doc, index, -1)),
        mini("chevronDown", "Move down · 下移", () => M.app.Move(app, doc, index, 1)),
        mini(if (type == "code") { "text"; } else { "code"; }, if (type == "code") { "To Markdown · 轉為文字 (M)"; } else { "To code · 轉為程式碼 (Y)"; },
            () => M.app.SetType(app, doc, index, if (type == "code") { "markdown"; } else { "code"; })),
        mini("plus", "Insert below · 在下方插入 (B)", () => M.app.Insert(app, doc, index + 1, "code")),
        mini("trash", "Delete · 刪除 (D, D)", () => M.app.DeleteCell(app, doc, index)),
    ]);
};

var Cell = function(app, doc, index, t) {
    var cell = doc.notebook["cells"][index];
    var id = cell["id"];
    var selected = index == doc.selected;
    var editing = doc.editing == id;
    var markdown = cell["cell_type"] == "markdown";
    var showEditor = !markdown || Array.Contains(doc.markdownEditing, id) || String.Trim(cell["source"]) == "";
    var body = null;
    if (showEditor) {
        var editor = M.app.EditorOf(app, doc, cell);
        M.editors.SetText(editor, cell["source"]);
        body = UI.Box(class: if (editing) { "codebox focused"; } else { "codebox"; }, child: M.editors.Widget(editor, function(focused) {
            if (focused) { doc.editing = id; doc.selected = Array.Index(doc.notebook["cells"], cell); }
            elif (doc.editing == id) { doc.editing = null; }
            if (app.surface != null) { app.surface.Rebuild(); }
            return null;
        }));
    } else {
        body = UI.Box(onDoubleTap: () => { Array.Append(doc.markdownEditing, id); FocusCell(app, doc, index); }, child: M.outputs.Markdown(cell["source"], t));
    }
    var outputs = if (markdown) { []; } else { cell["outputs"]; };
    var cls = if (editing) { "cell editing"; } elif (selected) { "cell selected"; } else { "cell"; };
    return UI.Box(class: cls, key: id, onPress: e => { doc.selected = Array.Index(doc.notebook["cells"], cell); }, children: [
        if (markdown) UI.Box(class: "prompt", child: UI.Text("")) else Prompt(app, doc, cell, t),
        UI.Expanded(child: UI.Column(crossAxis: "stretch", children: [
            body,
            if (len(outputs) > 0) UI.Column(class: "outputs", crossAxis: "stretch", children: [for (var o = 0; o < len(outputs); o++) M.outputs.Output(outputs[o], t, 800)]),
        ])),
        if (selected) CellTools(app, doc, index, cell, t),
    ]);
};

var Notebook = function(app, doc, t) {
    var cells = doc.notebook["cells"];
    return UI.ScrollView(key: "nb:" + doc.path, style: {"flexGrow": 1, "flexBasis": 0}, child: UI.Column(class: "notebook", crossAxis: "stretch", children: [
        for (var i = 0; i < len(cells); i++) Cell(app, doc, i, t),
        UI.Row(class: "addBar", children: [
            UI.Box(class: "ghost", onTap: () => M.app.Insert(app, doc, len(doc.notebook["cells"]), "code"), children: [icon("code", 13), UI.Text("Code")]),
            UI.Box(class: "ghost", onTap: () => M.app.Insert(app, doc, len(doc.notebook["cells"]), "markdown"), children: [icon("text", 13), UI.Text("Markdown")]),
        ]),
        UI.Box(style: {"height": 160}),
    ]));
};

# ---- 啟動頁 / The launcher ----
var LaunchCard = (name, title, text, onTap) => UI.Box(class: "launchCard", onTap: onTap, children: [
    UI.Box(class: "launchIcon", child: icon(name, 20, [255, 255, 255, 255])),
    UI.Text(title, style: {"fontWeight": 700, "fontSize": 15}),
    UI.Text(text, style: {"fontSize": 12, "lineHeight": 1.45d}),
]);
var Launcher = function(app, t) {
    var notebooks = Array.Filter(app.files, f => f["kind"] == "notebook");
    var shortcuts = [["Shift+Enter", "Run and move on · 執行並前往下一格"], ["Ctrl+Enter", "Run in place · 執行"], ["Esc / Enter", "Command / edit mode · 指令／編輯模式"],
        ["A / B", "Insert above / below · 上方／下方插入"], ["M / Y", "Markdown / code · 文字／程式碼"], ["D, D", "Delete the cell · 刪除儲存格"], ["Ctrl+S", "Save · 儲存"]];
    return UI.ScrollView(style: {"flexGrow": 1, "flexBasis": 0}, child: UI.Column(crossAxis: "stretch", children: [
        UI.Column(class: "hero", children: [
            UI.Box(class: "brandMark", style: {"width": 76, "height": 76, "borderRadius": 22}, child: UI.Text("W", style: {"color": "#ffffff", "fontWeight": 900, "fontSize": 40})),
            UI.Text("WellPlay", class: "heroTitle"),
            UI.Text("Write AquariusLang in cells, run them on this computer and see text, tables, charts and images right below. 在儲存格中撰寫星泉程式，在這台電腦上執行，結果就顯示在下方。", class: "heroText"),
        ]),
        UI.Row(class: "launchGrid", children: [
            LaunchCard("notebook", "New notebook", "Start an empty notebook in " + (if (app.dir == "") { "this folder"; } else { app.dir; }) + ". 新增筆記本。", () => M.app.NewNotebook(app)),
            ...Array.Map(Array.Slice(notebooks, 0, if (len(notebooks) > 5) { 5; } else { len(notebooks); }),
                entry => LaunchCard("play", entry["name"], "Open this notebook · 開啟筆記本", () => M.app.Open(app, entry["path"]))),
        ]),
        UI.Column(style: {"alignSelf": "center", "maxWidth": 640, "padding": 24, "gap": 8}, crossAxis: "stretch", children: [
            UI.Text("Keyboard · 鍵盤", style: {"fontWeight": 700, "color": t.muted, "fontSize": 13}),
            for (var i = 0; i < len(shortcuts); i++) UI.Row(gap: 12, crossAxis: "center", children: [
                UI.Box(style: {"width": 110}, child: UI.Text(shortcuts[i][0], class: "kbd")), UI.Text(shortcuts[i][1], style: {"fontSize": 13}),
            ]),
        ]),
    ]));
};

# ---- 狀態列、提示、對話框 / Status bar, toasts, dialogs ----
var StatusBar = function(app, t) {
    var doc = M.app.ActiveDoc(app);
    var root = if (app.info == null) { ""; } else { app.info["root"]; };
    return UI.Row(class: "statusbar", children: [
        UI.Row(gap: 6, crossAxis: "center", children: [UI.Box(class: "dot", style: {"background": if (app.status == "online") { t.success; } else { t.danger; }}), UI.Text(root, maxLines: 1)]),
        UI.Spacer(),
        if (doc != null) UI.Text(String.From(len(doc.notebook["cells"])) + " cells"),
        if (doc != null) UI.Text(if (doc.dirty) { "Unsaved · 未儲存"; } else { "Saved · 已儲存"; }),
        if (doc != null) UI.Text(if (doc.editing != null) { "Edit mode · 編輯"; } else { "Command mode · 指令"; }, style: {"color": if (doc.editing != null) { t.accent; } else { t.primary; }}),
        UI.Text("AquariusLang WellPlay " + if (app.info == null) { ""; } else { app.info["version"]; }),
    ]);
};
var Toast = function(app, t) {
    if (app.toast == null) { return null; }
    var color = if (app.toastKind == "error") { t.danger; } else { t.primary; };
    return UI.Positioned(left: 0, right: 0, bottom: 44, child: UI.Row(mainAxis: "center", children: [
        UI.Row(class: "toast", style: {"position": "relative", "bottom": 0}, children: [UI.Box(class: "dot", style: {"background": color}), UI.Text(app.toast)]),
    ]));
};
var Dialog = function(app, t) {
    var d = app.dialog;
    if (d == null) { return null; }
    var close = () => { app.dialog = null; };
    var kind = d["kind"];
    var title = "";
    var content = null;
    var action = null;
    if (kind == "rename") {
        title = "Rename · 重新命名";
        content = UI.TextField(value: d["value"], width: 320, onChanged: v => { d["value"] = v; }, onSubmit: v => { M.app.Rename(app, d["path"], v); app.dialog = null; });
        action = UI.Button("Rename", onPress: () => { M.app.Rename(app, d["path"], d["value"]); app.dialog = null; });
    } elif (kind == "folder") {
        title = "New folder · 新資料夾";
        content = UI.TextField(value: d["value"], width: 320, placeholder: "Folder name", onChanged: v => { d["value"] = v; }, onSubmit: v => { M.app.NewFolder(app, v); app.dialog = null; });
        action = UI.Button("Create", onPress: () => { M.app.NewFolder(app, d["value"]); app.dialog = null; });
    } elif (kind == "delete") {
        title = "Delete · 刪除";
        content = UI.Text("Delete " + d["value"] + " permanently? 永久刪除？");
        action = UI.Button("Delete", variant: "danger", onPress: () => { M.app.Delete(app, d["path"]); app.dialog = null; });
    } elif (kind == "restart") {
        title = "Restart the kernel · 重新啟動核心";
        content = UI.Text("Variables from earlier cells are forgotten; outputs stay. 先前儲存格的變數會被清除，輸出保留。");
        var doc = M.app.ActiveDoc(app);
        action = UI.Button("Restart", onPress: () => { if (doc != null) { M.app.Restart(app, doc); } app.dialog = null; });
    }
    return UI.Dialog(open: true, title: title, content: content, onDismiss: close, actions: [UI.Button("Cancel", variant: "text", onPress: close), action]);
};

# ---- 根 / The root ----
var Root = function(app) {
    var t = M.app.Palette(app);
    var doc = M.app.ActiveDoc(app);
    var page = if (doc == null) { Launcher(app, t); } else { Notebook(app, doc, t); };
    return UI.Stack(style: {"flexGrow": 1}, children: [
        UI.Column(class: "app", crossAxis: "stretch", style: {"position": "absolute", "left": 0, "top": 0, "right": 0, "bottom": 0}, children: [
            TopBar(app, t),
            UI.Row(crossAxis: "stretch", style: {"flexGrow": 1, "flexShrink": 1, "flexBasis": 0, "minHeight": 0}, children: [
                if (app.sidebar) Sidebar(app, t),
                UI.Column(crossAxis: "stretch", style: {"flexGrow": 1, "flexShrink": 1, "flexBasis": 0, "minWidth": 0, "minHeight": 0}, children: [
                    Tabs(app, t),
                    UI.Column(class: "page", crossAxis: "stretch", children: [page]),
                ]),
            ]),
            StatusBar(app, t),
        ]),
        Toast(app, t),
        Dialog(app, t),
    ]);
};

# ---- 鍵盤焦點 / Keyboard focus ----
# 找到某個儲存格的編輯器元素，讓它取得焦點（編輯模式）。 / Find a cell's editor element and focus it (edit mode).
var findElement = function(e, key) {
    if (e.widget != null && e.type == "Immediate" && e.widget.key == key) { return e; }
    for (var i = 0; i < len(e.children); i++) {
        var found = findElement(e.children[i], key);
        if (found != null) { return found; }
    }
    return null;
};
var FocusCell = function(app, doc, index) {
    var cell = doc.notebook["cells"][index];
    doc.selected = index;
    doc.editing = cell["id"];
    if (cell["cell_type"] == "markdown" && !Array.Contains(doc.markdownEditing, cell["id"])) { Array.Append(doc.markdownEditing, cell["id"]); }
    var s = app.surface;
    s.Rebuild();
    s.Frame(s.time);
    var element = findElement(s.tree, "editor-" + cell["id"]);
    if (element != null) { s.focus = element; }
    return null;
};
var Blur = function(app) {
    var s = app.surface;
    var doc = M.app.ActiveDoc(app);
    if (doc != null) { doc.editing = null; }
    s.focus = null;
    s.Rebuild();
    return null;
};
