##
JSON-RPC 2.0 端點（每次 建立端點 都會匯入一份獨立實例）：處理收到的請求與通知、發出呼叫並配對回應。
A JSON-RPC 2.0 endpoint (each CreateEndpoint imports its own instance): handles incoming requests and
notifications, makes calls and matches their responses.
##
變數 _錯誤 = 空值;
變數 _公開錯誤 = 空值;
變數 _是錯誤 = 空值;
變數 _錯誤回應 = 空值;
變數 _結果回應 = 空值;
變數 _轉JSON = 空值;
變數 _解析 = 空值;
變數 _種類 = 空值;
變數 _請求 = 空值;
變數 _通知訊息 = 空值;
變數 網路 = 匯入("網路");
變數 _自身 = 空值;
變數 _送出 = 空值;
變數 _方法 = {};
變數 _通知 = {};
變數 _其他 = 空值;
變數 _待回應 = {};
變數 _下個編號 = 1;
變數 _逾時 = 0;
變數 _關閉 = 假;
變數 _關閉傳輸 = 空值;
變數 _背景 = 空值;
變數 _結束完成 = 空值;
變數 _已結束 = 假;
變數 _當關閉 = 空值;
變數 _當錯誤 = 空值;

變數 設定自身 = 函式(模組) { _自身 = 模組; };
變數 內部初始化 = 函式(核心, 送出) {
    _送出 = 送出;
    _錯誤 = 核心["錯誤"]; _公開錯誤 = 核心["公開錯誤"]; _是錯誤 = 核心["是錯誤"]; _錯誤回應 = 核心["錯誤回應"]; _結果回應 = 核心["結果回應"];
    _轉JSON = 核心["轉JSON"]; _解析 = 核心["解析"]; _種類 = 核心["訊息種類"]; _請求 = 核心["請求"]; _通知訊息 = 核心["通知訊息"];
    回傳 真;
};
變數 內部設定關閉 = 函式(函數) { _關閉傳輸 = 函數; };
變數 內部背景 = 函式(承) { _背景 = 承; };

# ---- 處理 / Handling ----
# 註冊方法；處理函式(參數, 情境) 回傳結果、rpc.錯誤(...) 或承諾（可為非同步函式）。
# Register a method; handler(params, context) returns a result, an rpc.Error(...) or a promise (async handlers).
變數 處理, Handle = 函式(方法, 處理函式) { _方法[方法] = 處理函式; 回傳 _自身; };
# 註冊通知處理函式(參數, 情境)。 / Register a notification handler(params, context).
變數 當通知, OnNotification = 函式(方法, 處理函式) { _通知[方法] = 處理函式; 回傳 _自身; };
# 其他方法：處理函式(方法, 參數, 情境) 接手沒有註冊的請求與通知（例如轉送）。
# Anything else: handler(method, params, context) takes unregistered requests and notifications (e.g. to forward).
變數 處理其他, HandleOther = 函式(處理函式) { _其他 = 處理函式; 回傳 _自身; };
變數 移除方法, Unhandle = 函式(方法) { 雜湊.刪除鍵(_方法, 方法); 雜湊.刪除鍵(_通知, 方法); 回傳 _自身; };
變數 方法列表, Methods = 函式() { 雜湊.鍵列表(_方法); };
變數 當關閉, OnClose = 函式(回呼) { _當關閉 = 回呼; };
# 收到無法處理的訊息時（例如不認得的回應）。 / Called for messages that cannot be handled (unknown responses).
變數 當錯誤, OnError = 函式(回呼) { _當錯誤 = 回呼; };

變數 _情境 = 函式(方法, 編號) {
    回傳 {"method": 方法, "id": 編號, "endpoint": _自身};
};

# 執行處理函式並把結果（或錯誤）轉成承諾：執行期錯誤以其訊息拒絕，回傳的承諾照原樣（錯誤物件保持雜湊）。
# Run a handler as a promise: a runtime error rejects with its message, a returned promise passes on as it is.
變數 _執行 = 非同步 函式(處理函式, 引數) {
    # 只傳處理函式宣告的參數（原生函式取全部）。 / Pass only the parameters the handler declares (natives get all).
    變數 數量 = 參數個數(處理函式);
    如果 (數量 < 0 || 數量 > 長度(引數)) { 數量 = 長度(引數); }
    如果 (數量 == 0) { 回傳 處理函式(); }
    如果 (數量 == 1) { 回傳 處理函式(引數[0]); }
    如果 (數量 == 2) { 回傳 處理函式(引數[0], 引數[1]); }
    回傳 處理函式(引數[0], 引數[1], 引數[2]);
};

# 一個請求或通知的回應雜湊（通知為空值）。 / The response of one request or notification (null for notifications).
變數 _回應 = 非同步 函式(訊息) {
    變數 種類 = _種類(訊息);
    如果 (種類 == "invalid") { 回傳 _錯誤回應(空值, _錯誤(-32600, 空值, 空值)); }
    如果 (種類 == "response") { _收到回應(訊息); 回傳 空值; }
    變數 方法 = 訊息["method"];
    變數 參數 = 訊息["params"];
    變數 是通知 = 種類 == "notification";
    變數 編號 = 訊息["id"];
    變數 處理函式 = 如果 (是通知) { _通知[方法]; } 否則 { _方法[方法]; };
    變數 承 = 空值;
    如果 (處理函式 != 空值) { 承 = _執行(處理函式, [參數, _情境(方法, 編號)]); }
    否則如果 (_其他 != 空值) { 承 = _執行(_其他, [方法, 參數, _情境(方法, 編號)]); }
    否則如果 (是通知) { 回傳 空值; }
    否則 { 回傳 _錯誤回應(編號, _錯誤(-32601, 空值, {"method": 方法})); }
    變數 結局 = 等待 承.然後(
        函式(值) { 回傳 {"ok": 真, "value": 值}; },
        函式(原因) { 回傳 {"ok": 假, "reason": 原因}; });
    如果 (是通知) { 回傳 空值; }
    如果 (結局["ok"]) {
        變數 值 = 結局["value"];
        如果 (_是錯誤(值)) { 回傳 _錯誤回應(編號, 值); }
        如果 (型別(值) == "null") { 值 = 空值; }
        回傳 _結果回應(編號, 值);
    }
    變數 原因 = 結局["reason"];
    如果 (_是錯誤(原因)) { 回傳 _錯誤回應(編號, 原因); }
    回傳 _錯誤回應(編號, _錯誤(-32603, 字串.轉文字(原因), 空值));
};

# 一段收到的文字的回應文字（沒有要回應的則為 ""）。 / The response text of a received text ("" when none).
變數 處理文字, Process = 非同步 函式(文字) {
    變數 解析 = _解析(文字);
    如果 (!解析["ok"]) { 回傳 _轉JSON(_錯誤回應(空值, _錯誤(-32700, 空值, 空值))); }
    變數 訊息 = 解析["value"];
    如果 (型別(訊息) == "array") {
        如果 (長度(訊息) == 0) { 回傳 _轉JSON(_錯誤回應(空值, _錯誤(-32600, 空值, 空值))); }
        變數 工作們 = [];
        迴圈 (變數 索引 = 0; 索引 < 長度(訊息); 索引++) { 陣列.追加(工作們, _回應(訊息[索引])); }
        變數 回應們 = 陣列.篩選(等待 承諾.全部(工作們), 函式(回應) { 回傳 回應 != 空值; });
        如果 (長度(回應們) == 0) { 回傳 ""; }
        回傳 _轉JSON(回應們);
    }
    變數 回應 = 等待 _回應(訊息);
    如果 (回應 == 空值) { 回傳 ""; }
    回傳 _轉JSON(回應);
};

# 接收傳輸交來的文字：處理請求並把回應交給 送出。 / Receive a text from the transport: handle it and send replies.
變數 接收, Receive = 函式(文字) {
    回傳 處理文字(文字).然後(函式(答覆) {
        如果 (答覆 != "") { _送(答覆, 空值); }
        回傳 真;
    });
};

# ---- 呼叫 / Calls ----
變數 _送 = 函式(文字, 訊息) {
    如果 (_送出 == 空值) { 回傳 假; }
    變數 結果 = _送出(文字, 訊息);
    如果 (承諾.是承諾(結果)) { 結果.捕捉(函式(原因) { 回傳 假; }); }
    回傳 真;
};

變數 _收到回應 = 函式(訊息) {
    變數 編號 = 訊息["id"];
    變數 待 = _待回應[編號];
    如果 (待 == 空值) {
        如果 (_當錯誤 != 空值) { _當錯誤("Response for an unknown id / 未知編號的回應", 訊息); }
        回傳 假;
    }
    雜湊.刪除鍵(_待回應, 編號);
    如果 (雜湊.包含鍵(訊息, "error")) {
        變數 錯誤值 = 訊息["error"];
        如果 (型別(錯誤值) != "hash") { 錯誤值 = {"code": -32603, "message": "Invalid error"}; }
        待["拒絕"](_公開錯誤(_錯誤(錯誤值["code"], 錯誤值["message"], 錯誤值["data"])));
    } 否則 {
        待["完成"](訊息["result"]);
    }
    回傳 真;
};

變數 _新呼叫 = 函式(方法, 參數) {
    變數 編號 = _下個編號;
    _下個編號++;
    變數 承 = 承諾.建立(函式(完成, 拒絕) { _待回應[編號] = {"完成": 完成, "拒絕": 拒絕}; });
    如果 (_逾時 > 0) {
        承 = 承諾.逾時(承, _逾時, _公開錯誤(_錯誤(-32000, 空值, {"method": 方法})));
        承.捕捉(函式(原因) { 雜湊.刪除鍵(_待回應, 編號); 回傳 空值; });
    }
    回傳 {"id": 編號, "promise": 承, "message": _請求(方法, 參數, 編號)};
};

# 呼叫遠端方法：承諾得到結果，或以錯誤物件 {"code", "message", "data"} 拒絕。
# Call a remote method: a promise of the result, or a rejection with the error object {"code", "message", "data"}.
變數 呼叫, Call = 函式(方法, 參數) {
    如果 (_關閉) { 回傳 承諾.拒絕(_公開錯誤(_錯誤(-32001, 空值, 空值))); }
    變數 呼 = _新呼叫(方法, 參數);
    _送(_轉JSON(呼["message"]), 呼["message"]);
    回傳 呼["promise"];
};

# 送出通知（沒有回應）。 / Send a notification (no response).
變數 通知, Notify = 函式(方法, 參數) {
    如果 (_關閉) { 回傳 假; }
    變數 訊息 = _通知訊息(方法, 參數);
    回傳 _送(_轉JSON(訊息), 訊息);
};

# 一次送出多個呼叫：呼叫們 是 [[方法, 參數], ...]（第三項為 真 表示通知）；承諾得到依序的
# {"result": 值} 或 {"error": 錯誤}（通知為空值）。
# Send several calls at once: calls is [[method, params], ...] (a true third item makes a notification); a promise
# of {"result": value} or {"error": error} in order (null for notifications).
變數 批次, Batch = 非同步 函式(呼叫們) {
    如果 (_關閉) { 回傳 承諾.拒絕(_公開錯誤(_錯誤(-32001, 空值, 空值))); }
    變數 訊息們 = [];
    變數 承們 = [];
    迴圈 (變數 索引 = 0; 索引 < 長度(呼叫們); 索引++) {
        變數 項目 = 呼叫們[索引];
        如果 (長度(項目) > 2 && 項目[2] == 真) {
            陣列.追加(訊息們, _通知訊息(項目[0], 項目[1]));
            陣列.追加(承們, 承諾.解決(空值));
        } 否則 {
            變數 呼 = _新呼叫(項目[0], 項目[1]);
            陣列.追加(訊息們, 呼["message"]);
            陣列.追加(承們, 呼["promise"]);
        }
    }
    _送(_轉JSON(訊息們), 訊息們);
    變數 結局們 = 等待 承諾.全部結算(承們);
    變數 結果 = [];
    迴圈 (變數 索引 = 0; 索引 < 長度(結局們); 索引++) {
        如果 (長度(呼叫們[索引]) > 2 && 呼叫們[索引][2] == 真) { 陣列.追加(結果, 空值); }
        否則如果 (結局們[索引]["status"] == "fulfilled") { 陣列.追加(結果, {"result": 結局們[索引]["value"]}); }
        否則 { 陣列.追加(結果, {"error": 結局們[索引]["reason"]}); }
    }
    回傳 結果;
};

# 每個呼叫的逾時（毫秒，0 為不限）；逾時以 -32000 拒絕。 / A per-call timeout (ms, 0 for none); rejects with -32000.
變數 設定逾時, SetTimeout = 函式(毫秒) { _逾時 = 毫秒; 回傳 _自身; };
變數 待回應數, PendingCount = 函式() { 長度(_待回應); };
變數 已關閉, IsClosed = 函式() { _關閉; };

# 傳輸送不出去：拒絕這則訊息裡的呼叫。 / The transport failed: reject the calls of that message.
變數 內部傳輸失敗 = 函式(訊息, 原因) {
    變數 列表 = 如果 (型別(訊息) == "array") { 訊息; } 否則 { [訊息]; };
    迴圈 (變數 索引 = 0; 索引 < 長度(列表); 索引++) {
        如果 (型別(列表[索引]) == "hash") {
            變數 編號 = 列表[索引]["id"];
            變數 待 = _待回應[編號];
            如果 (待 != 空值) { 雜湊.刪除鍵(_待回應, 編號); 待["拒絕"](_公開錯誤(_錯誤(-32002, 原因, 空值))); }
        }
    }
    回傳 真;
};

# 拒絕所有等待中的呼叫並停止。 / Reject every pending call and stop.
變數 _結束 = 函式(原因) {
    如果 (_關閉) { 回傳 假; }
    _關閉 = 真;
    變數 編號們 = 雜湊.鍵列表(_待回應);
    迴圈 (變數 索引 = 0; 索引 < 長度(編號們); 索引++) {
        _待回應[編號們[索引]]["拒絕"](_公開錯誤(_錯誤(-32001, 原因, 空值)));
    }
    _待回應 = {};
    如果 (_當關閉 != 空值) { _當關閉(原因); }
    回傳 真;
};
# 連線結束時傳輸呼叫。 / The transport calls this when its connection ended.
變數 內部連線結束 = 函式(原因) {
    _結束(原因);
    _已結束 = 真;
    如果 (_結束完成 != 空值) { 變數 完成 = _結束完成; _結束完成 = 空值; 完成(真); }
    回傳 真;
};
# 承諾在連線結束後完成。 / A promise that settles once the connection ended.
變數 已結束, Ended = 函式() {
    如果 (_已結束) { 回傳 承諾.解決(真); }
    回傳 承諾.建立(函式(完成, 拒絕) { _結束完成 = 完成; });
};
變數 關閉, Close = 函式() {
    _結束("Endpoint closed / 端點已關閉");
    如果 (_關閉傳輸 != 空值) { _關閉傳輸(); }
    回傳 真;
};
