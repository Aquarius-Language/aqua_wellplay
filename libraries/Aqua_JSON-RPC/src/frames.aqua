##
Content-Length 分框讀取器（每次 建立分框讀取器 都會匯入一份獨立實例）：與 LSP 的基本協定相同，標頭以 CRLF 結尾，
空行之後是 Content-Length 位元組的 UTF-8 JSON。
A Content-Length frame reader (each CreateFrameReader imports its own instance), as LSP's base protocol: header
lines end in CRLF, then a blank line and Content-Length bytes of UTF-8 JSON.
##
變數 _網路 = 空值;
變數 _緩衝 = [];
變數 _錯誤 = "";
變數 _上限 = 67108864;

變數 內部初始化 = 函式(網路) { _網路 = 網路; };

# 標頭結束（\r\n\r\n）的位置，沒有則 -1。 / Where the header ends (\r\n\r\n), or -1.
變數 _標頭結尾 = 函式() {
    迴圈 (變數 索引 = 0; 索引 + 3 < 長度(_緩衝); 索引++) {
        如果 (_緩衝[索引] == 13 && _緩衝[索引 + 1] == 10 && _緩衝[索引 + 2] == 13 && _緩衝[索引 + 3] == 10) { 回傳 索引; }
    }
    回傳 -1;
};

變數 餵入, Feed = 函式(位元組) { 陣列.追加陣列(_緩衝, 位元組); 回傳 長度(_緩衝); };
變數 錯誤, Error = 函式() { _錯誤; };
變數 緩衝長度, BufferedLength = 函式() { 長度(_緩衝); };

# 取出所有完整的訊息文字。 / Take every complete message text.
變數 取出, Take = 函式() {
    變數 結果 = [];
    迴圈 (; _錯誤 == "";) {
        變數 結尾 = _標頭結尾();
        如果 (結尾 < 0) { 中斷; }
        變數 標頭 = 字串.分割(_網路.位元組轉文字(陣列.切片(_緩衝, 0, 結尾)), 字串.從字元碼(13) + 字串.從字元碼(10));
        變數 內容長度 = -1;
        迴圈 (變數 索引 = 0; 索引 < 長度(標頭); 索引++) {
            變數 行 = 標頭[索引];
            如果 (字串.開頭是(字串.轉小寫(行), "content-length:")) {
                內容長度 = 字串.解析整數(字串.修剪(字串.切片(行, 15, 長度(行))));
            }
        }
        如果 (內容長度 == 空值 || 內容長度 < 0 || 內容長度 > _上限) { _錯誤 = "Invalid Content-Length / 無效的 Content-Length"; 中斷; }
        變數 開始 = 結尾 + 4;
        如果 (長度(_緩衝) < 開始 + 內容長度) { 中斷; }
        陣列.追加(結果, _網路.位元組轉文字(陣列.切片(_緩衝, 開始, 開始 + 內容長度)));
        陣列.刪除(_緩衝, 0, 開始 + 內容長度);
    }
    回傳 結果;
};
