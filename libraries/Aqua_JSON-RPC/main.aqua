##
Aqua_JSON-RPC 1.0.0 — 星泉 JSON-RPC 2.0 函式庫 / JSON-RPC 2.0 for AquariusLang.

完整實作 JSON-RPC 2.0 規格（https://www.jsonrpc.org/specification）：請求、通知、回應、批次、標準錯誤碼。
端點是雙向的：同一端可以處理呼叫也可以發出呼叫（如同語言伺服器協定）。呼叫回傳承諾，處理函式可以是非同步函式。
A complete JSON-RPC 2.0 implementation: requests, notifications, responses, batches and the standard error codes.
Endpoints are symmetric: one side may both handle and make calls (as the Language Server Protocol does). Calls
return promises; handlers may be async functions.

傳輸 / Transports:
- 所有平台 / every target: HTTP 用戶端、WebSocket 用戶端、行程內配對 / HTTP client, WebSocket client, in-process pair.
- 桌面與 Android / desktop and Android: HTTP 伺服器、WebSocket 伺服器、TCP（Content-Length 分框，與 LSP 相同）。
  HTTP server, WebSocket server, TCP with Content-Length framing (as LSP uses).
- 任何傳輸 / any transport: 建立端點(送出函式) + 接收(文字) / CreateEndpoint(send) + Receive(text).

    var rpc = import("AquaJSONRPC");
    var server = import("Network").Listen(":8080");
    var api = rpc.CreateEndpoint(null);
    api.Handle("add", function(params) { return params[0] + params[1]; });
    rpc.ServeHttp(server, "/rpc", api);
    server.Serve();

所有公開函式皆提供繁體中文與英文名稱。 / Every public function has Traditional Chinese and English names.
##
變數 網路 = 匯入("網路");
變數 序列化 = 匯入("序列化");

變數 版本, Version = 函式() { "1.0.0"; };

# 選項值（英文或中文鍵）。 / An option by its English or Chinese key.
變數 選項值, OptionValue = 函式(選項, 英文鍵, 中文鍵, 預設值) {
    如果 (選項 == 空值) { 回傳 預設值; }
    如果 (選項[英文鍵] != 空值) { 回傳 選項[英文鍵]; }
    如果 (選項[中文鍵] != 空值) { 回傳 選項[中文鍵]; }
    回傳 預設值;
};

# ---- 標準錯誤碼 / Standard error codes ----
變數 解析錯誤 = -32700;
變數 ParseError = 解析錯誤;
變數 無效請求 = -32600;
變數 InvalidRequest = 無效請求;
變數 找不到方法 = -32601;
變數 MethodNotFound = 找不到方法;
變數 無效參數 = -32602;
變數 InvalidParams = 無效參數;
變數 內部錯誤 = -32603;
變數 InternalError = 內部錯誤;
# 伺服器保留範圍 -32000..-32099：本函式庫用於逾時、端點已關閉與傳輸失敗。
# Server range -32000..-32099: used here for timeouts, closed endpoints and transport failures.
變數 逾時錯誤 = -32000;
變數 TimeoutError = 逾時錯誤;
變數 已關閉錯誤 = -32001;
變數 ClosedError = 已關閉錯誤;
變數 傳輸錯誤 = -32002;
變數 TransportError = 傳輸錯誤;

變數 _標準訊息 = {-32700: "Parse error", -32600: "Invalid Request", -32601: "Method not found", -32602: "Invalid params",
    -32603: "Internal error", -32000: "Request timed out", -32001: "Endpoint closed", -32002: "Transport error"};
變數 _標記 = "jsonrpc.error";

# 錯誤物件；處理函式回傳（或以 承諾.拒絕 拒絕）它就送出錯誤回應。訊息為空值時使用標準訊息。
# An error object; a handler that returns it (or rejects with it) answers with that error. A null message takes the
# standard one.
變數 錯誤, Error = 函式(代碼, 訊息, 資料) {
    如果 (訊息 == 空值) { 訊息 = _標準訊息[代碼]; }
    如果 (訊息 == 空值) { 訊息 = "Server error"; }
    變數 結果 = {"code": 代碼, "message": 訊息};
    結果[_標記] = 真;
    如果 (資料 != 空值) { 結果["data"] = 資料; }
    回傳 結果;
};
# 錯誤物件：錯誤(...) 的結果，或呼叫被拒絕時收到的 {"code", "message", "data"}。
# An error object: what Error(...) makes, or the {"code", "message", "data"} a rejected call gives.
變數 是錯誤, IsError = 函式(值) {
    如果 (型別(值) != "hash") { 回傳 假; }
    如果 (值[_標記] == 真) { 回傳 真; }
    回傳 型別(值["code"]) == "integer" && 型別(值["message"]) == "string" && 長度(值) <= 3;
};
# 參數不符時的錯誤（-32602）。 / The error for wrong parameters (-32602).
變數 參數錯誤, InvalidParamsError = 函式(訊息) { 錯誤(-32602, 訊息, 空值); };

# 送出的錯誤物件（去掉內部標記）。 / An error as sent (without the internal marker).
變數 公開錯誤, PublicError = 函式(值) {
    變數 結果 = {"code": 值["code"], "message": 值["message"]};
    如果 (雜湊.包含鍵(值, "data")) { 結果["data"] = 值["data"]; }
    回傳 結果;
};

# ---- 訊息 / Messages ----
變數 請求, Request = 函式(方法, 參數, 編號) {
    變數 訊息 = {"jsonrpc": "2.0", "method": 方法};
    如果 (參數 != 空值) { 訊息["params"] = 參數; }
    訊息["id"] = 編號;
    回傳 訊息;
};
變數 通知訊息, Notification = 函式(方法, 參數) {
    變數 訊息 = {"jsonrpc": "2.0", "method": 方法};
    如果 (參數 != 空值) { 訊息["params"] = 參數; }
    回傳 訊息;
};
變數 結果回應, ResultResponse = 函式(編號, 結果) { {"jsonrpc": "2.0", "result": 結果, "id": 編號}; };
變數 錯誤回應, ErrorResponse = 函式(編號, 錯誤值) { {"jsonrpc": "2.0", "error": 公開錯誤(錯誤值), "id": 編號}; };

變數 轉JSON, ToJSON = 函式(值) { 序列化.JSON序列化(值); };
# 解析 JSON；格式錯誤時回傳 {"ok": 假}。 / Parse JSON; {"ok": false} for malformed text.
變數 解析, Parse = 函式(文字) {
    變數 結果 = 網路.嘗試(函式() { 回傳 序列化.解析JSON(文字); });
    如果 (!結果.成功) { 回傳 {"ok": 假}; }
    回傳 {"ok": 真, "value": 結果.值};
};

# 一則訊息的種類："request"、"notification"、"response"、"batch" 或 "invalid"。
# The kind of a parsed message: "request", "notification", "response", "batch" or "invalid".
變數 訊息種類, Kind = 函式(訊息) {
    如果 (型別(訊息) == "array") { 回傳 "batch"; }
    如果 (型別(訊息) != "hash") { 回傳 "invalid"; }
    如果 (訊息["jsonrpc"] != "2.0") { 回傳 "invalid"; }
    如果 (雜湊.包含鍵(訊息, "method")) {
        如果 (型別(訊息["method"]) != "string") { 回傳 "invalid"; }
        如果 (雜湊.包含鍵(訊息, "params")) {
            變數 參數型別 = 型別(訊息["params"]);
            如果 (參數型別 != "array" && 參數型別 != "hash") { 回傳 "invalid"; }
        }
        如果 (!雜湊.包含鍵(訊息, "id")) { 回傳 "notification"; }
        變數 編號型別 = 型別(訊息["id"]);
        如果 (編號型別 != "integer" && 編號型別 != "double" && 編號型別 != "string" && 編號型別 != "null") { 回傳 "invalid"; }
        回傳 "request";
    }
    如果 (雜湊.包含鍵(訊息, "id") && (雜湊.包含鍵(訊息, "result") || 雜湊.包含鍵(訊息, "error"))) { 回傳 "response"; }
    回傳 "invalid";
};

# ---- 分框（LSP 的 Content-Length 標頭） / Framing (LSP's Content-Length header) ----
變數 _換行 = 字串.從字元碼(13) + 字串.從字元碼(10);
# 一則訊息的分框位元組。 / The framed bytes of a message.
變數 分框, Frame = 函式(文字) {
    變數 內容 = 網路.文字轉位元組(文字);
    變數 結果 = 網路.文字轉位元組("Content-Length: " + 字串.轉文字(長度(內容)) + _換行 + _換行);
    陣列.追加陣列(結果, 內容);
    回傳 結果;
};
# 分框讀取器：餵入位元組，取出完整訊息。 / A frame reader: feed bytes, take complete messages.
變數 建立分框讀取器, CreateFrameReader = 函式() {
    變數 讀取器 = 匯入("src/frames.aqua");
    讀取器.內部初始化(網路);
    回傳 讀取器;
};

# ---- 端點 / Endpoints ----
變數 _核心 = {"公開錯誤": 公開錯誤, "錯誤": 錯誤, "是錯誤": 是錯誤, "錯誤回應": 錯誤回應, "結果回應": 結果回應, "轉JSON": 轉JSON, "解析": 解析,
    "訊息種類": 訊息種類, "請求": 請求, "通知訊息": 通知訊息};
# 建立端點；送出 是 函式(文字, 訊息)，把要送出的 JSON 交給傳輸（可為空值，例如只用 處理文字 的 HTTP 伺服器）。
# Create an endpoint; `send` is function(text, message) handing outgoing JSON to the transport (may be null, e.g.
# for an HTTP server that only uses Process).
變數 建立端點, CreateEndpoint = 函式(送出) {
    變數 端點 = 匯入("src/endpoint.aqua");
    端點.設定自身(端點);
    端點.內部初始化(_核心, 送出);
    回傳 端點;
};

# 行程內的一對端點：一端送出的訊息由另一端接收（之後的回合，順序不變）。測試與內嵌服務使用。
# Two connected endpoints in one process: what one sends the other receives (at a later turn, in order). For tests
# and embedded services.
變數 建立配對, CreatePair = 函式() {
    變數 兩端 = [空值, 空值];
    兩端[0] = 建立端點(函式(文字, 訊息) { 承諾.解決(文字).然後(函式(t) { 兩端[1].接收(t); }); 回傳 真; });
    兩端[1] = 建立端點(函式(文字, 訊息) { 承諾.解決(文字).然後(函式(t) { 兩端[0].接收(t); }); 回傳 真; });
    回傳 兩端;
};

# ---- HTTP ----
# HTTP 用戶端端點（所有平台）：每則訊息以 POST 送出，回應本文交給端點。選項：標頭/headers、逾時/timeout。
# An HTTP client endpoint (every target): each message is POSTed and the response body handed to the endpoint.
變數 HTTP用戶端, HttpClient = 函式(網址, 選項) {
    變數 標頭 = 雜湊.克隆(選項值(選項, "headers", "標頭", {}));
    標頭["Content-Type"] = "application/json";
    變數 設定 = {"headers": 標頭, "timeout": 選項值(選項, "timeout", "逾時", 30000)};
    變數 端點們 = [空值];
    端點們[0] = 建立端點(非同步 函式(文字, 訊息) {
        變數 回應 = 等待 網路.非同步提交(網址, 文字, 設定);
        如果 (回應.狀態碼 == 200 && 回應.本文 != "") { 端點們[0].接收(回應.本文); 回傳 真; }
        如果 (回應.狀態碼 == 204 || 回應.狀態碼 == 202) { 回傳 真; }
        變數 原因 = "HTTP " + 字串.轉文字(回應.狀態碼);
        如果 (回應.狀態碼 == 0 && 回應.錯誤 != 空值) { 原因 = 回應.錯誤.訊息; }
        端點們[0].內部傳輸失敗(訊息, 原因);
        回傳 假;
    });
    回傳 端點們[0];
};

# 在「網路」伺服器的路徑上以 POST 提供端點（桌面、Android）。只有通知時回應 204。
# Serve an endpoint with POST on a path of a Network server (desktop, Android); 204 when only notifications came.
變數 HTTP服務, ServeHttp = 函式(伺服器, 路徑, 端點) {
    伺服器.處理(路徑, 非同步 函式(請求, 回應) {
        如果 (請求.方法 != "POST") { 回應.設定標頭("Allow", "POST"); 回應.錯誤(405); 回傳 空值; }
        變數 答覆 = 等待 端點.處理文字(請求.本文);
        如果 (答覆 == "") { 回應.狀態(204); 回應.寫入(""); 回傳 空值; }
        回應.設定標頭("Content-Type", "application/json; charset=utf-8");
        回應.寫入(答覆);
        回傳 空值;
    });
    回傳 伺服器;
};

# ---- WebSocket ----
# 一條 WebSocket（「網路」函式庫的通訊端）上的端點，在背景接收直到關閉。 / An endpoint on a Network WebSocket,
# receiving in the background until it closes.
變數 WebSocket端點, WebSocketEndpoint = 函式(通訊端) {
    變數 端點 = 建立端點(函式(文字, 訊息) { 回傳 網路.嘗試(函式() { 通訊端.傳送文字(文字); }).成功; });
    端點.內部設定關閉(函式() { 網路.嘗試(函式() { 通訊端.關閉(1000, ""); }); });
    端點.內部背景(_接收WebSocket(通訊端, 端點));
    回傳 端點;
};
變數 _接收WebSocket = 非同步 函式(通訊端, 端點) {
    迴圈 (;;) {
        變數 訊息 = 等待 通訊端.非同步接收().捕捉(函式(原因) { 回傳 空值; });
        如果 (訊息 == 空值 || 訊息.已關閉) { 中斷; }
        如果 (訊息.是文字) { 端點.接收(訊息.文字); } 否則 { 端點.接收(網路.位元組轉文字(訊息.資料)); }
    }
    端點.內部連線結束("WebSocket closed / WebSocket 已關閉");
    回傳 空值;
};

# 連到 WebSocket JSON-RPC 服務（所有平台）：承諾在連線開啟後得到端點。選項同「網路」的 連接網頁通訊端。
# Connect to a WebSocket JSON-RPC service (every target): a promise of the endpoint once open.
變數 WebSocket連線, ConnectWebSocketAsync = 非同步 函式(網址, 選項) {
    如果 (選項 == 空值) { 選項 = {}; }
    變數 通訊端 = 等待 網路.非同步連接網頁通訊端(網址, 選項);
    回傳 WebSocket端點(通訊端);
};

# 在「網路」伺服器的路徑上接受 WebSocket 連線（桌面、Android）；每條連線建立一個端點交給 當連線(端點, 請求)。
# Accept WebSocket connections on a path of a Network server (desktop, Android); each one becomes an endpoint
# passed to onConnect(endpoint, request).
變數 WebSocket服務, ServeWebSocket = 函式(伺服器, 路徑, 當連線) {
    伺服器.處理("GET " + 路徑, 非同步 函式(請求, 回應) {
        變數 通訊端 = 回應.升級網頁通訊端(["jsonrpc"]);
        變數 端點 = WebSocket端點(通訊端);
        當連線(端點, 請求);
        等待 端點.已結束();
        回傳 空值;
    });
    回傳 伺服器;
};

# ---- TCP 與串流（Content-Length 分框） / TCP and streams (Content-Length framing) ----
# 「網路」串流（TCP、TLS）上的端點，與 LSP 的基本協定相同。 / An endpoint on a Network stream (TCP, TLS) with LSP's
# base protocol framing.
變數 串流端點, StreamEndpoint = 函式(串流) {
    變數 端點 = 建立端點(函式(文字, 訊息) { 回傳 網路.嘗試(函式() { 串流.寫入(分框(文字)); }).成功; });
    端點.內部設定關閉(函式() { 網路.嘗試(函式() { 串流.關閉(); }); });
    端點.內部背景(_接收串流(串流, 端點));
    回傳 端點;
};
變數 _接收串流 = 非同步 函式(串流, 端點) {
    變數 讀取器 = 建立分框讀取器();
    迴圈 (;;) {
        變數 位元組 = 等待 串流.非同步讀取(65536).捕捉(函式(原因) { 回傳 空值; });
        如果 (位元組 == 空值 || 長度(位元組) == 0) { 中斷; }
        讀取器.餵入(位元組);
        變數 訊息們 = 讀取器.取出();
        迴圈 (變數 索引 = 0; 索引 < 長度(訊息們); 索引++) { 端點.接收(訊息們[索引]); }
        如果 (讀取器.錯誤() != "") { 中斷; }
    }
    端點.內部連線結束("Stream closed / 串流已關閉");
    回傳 空值;
};

# 連到 TCP JSON-RPC 服務（桌面、Android），例如以 TCP 提供的語言伺服器。 / Connect to a TCP JSON-RPC service
# (desktop, Android), such as a language server listening on TCP.
變數 TCP連線, ConnectTCPAsync = 非同步 函式(主機, 連接埠) {
    變數 串流 = 等待 網路.非同步連接傳輸控制(主機, 連接埠);
    回傳 串流端點(串流);
};

# 在 TCP 連接埠接受 JSON-RPC 連線（桌面、Android）；回傳監聽器（關閉它即停止）。
# Accept JSON-RPC connections on a TCP port (desktop, Android); returns the listener (close it to stop).
變數 TCP服務, ServeTCP = 函式(位址, 連接埠, 當連線) {
    變數 監聽器 = 網路.監聽傳輸控制(位址, 連接埠);
    _接受TCP(監聽器, 當連線);
    回傳 監聽器;
};
變數 _接受TCP = 非同步 函式(監聽器, 當連線) {
    迴圈 (;;) {
        變數 串流 = 等待 監聽器.非同步接受().捕捉(函式(原因) { 回傳 "closed"; });
        如果 (型別(串流) == "string") { 中斷; }
        如果 (串流 != 空值) { 當連線(串流端點(串流), 串流); }
    }
    回傳 空值;
};
