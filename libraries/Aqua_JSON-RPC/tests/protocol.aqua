# 規格範例與端點行為（所有平台）。 / The specification's examples and endpoint behavior (every target).
# 預期輸出結尾為 JSONRPC_PROTOCOL_OK。 / Ends with JSONRPC_PROTOCOL_OK.
var rpc = import("AquaJSONRPC");
var failures = [];
var json = import("Serialization");
var check = function(name, actual, expected) {
    if (json.Json(actual) != json.Json(expected)) { 陣列.追加(failures, name); print("FAIL", name, actual, "!=", expected); }
};

# 規格（https://www.jsonrpc.org/specification#examples）的伺服器。 / The specification's example server.
var server = rpc.CreateEndpoint(null);
server.Handle("subtract", function(params, context) {
    if (typeOf(params) == "hash") { return params["minuend"] - params["subtrahend"]; }
    return params[0] - params[1];
});
server.Handle("sum", function(params) { return 陣列.總和(params); });
server.Handle("get_data", function(params) { return ["hello", 5]; });
server.Handle("slow", async function(params) { await 承諾.延遲(5); return "later"; });
server.Handle("boom", function(params) { return [1][5] + 1; });
server.Handle("refuse", function(params) { return rpc.Error(-32050, "refused", {"why": "test"}); });
server.Handle("reject", async function(params) { return 承諾.拒絕(rpc.InvalidParamsError("need two numbers")); });
var notes = [];
server.OnNotification("update", function(params) { 陣列.追加(notes, params); });
server.OnNotification("foobar", function(params) { 陣列.追加(notes, "foobar"); });

var exchange = async function(text) { return await server.Process(text); };
check("positional", await exchange("{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42, 23], \"id\": 1}"), "{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":1}");
check("named", await exchange("{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": {\"subtrahend\": 23, \"minuend\": 42}, \"id\": 3}"), "{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":3}");
check("notification", await exchange("{\"jsonrpc\": \"2.0\", \"method\": \"update\", \"params\": [1,2,3,4,5]}"), "");
check("not found", await exchange("{\"jsonrpc\": \"2.0\", \"method\": \"foobar\", \"id\": \"1\"}"), "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\",\"data\":{\"method\":\"foobar\"}},\"id\":\"1\"}");
check("parse error", await exchange("{\"jsonrpc\": \"2.0\", \"method\": \"foobar, \"params\": \"bar\", \"baz]"), "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32700,\"message\":\"Parse error\"},\"id\":null}");
check("invalid request", await exchange("{\"jsonrpc\": \"2.0\", \"method\": 1, \"params\": \"bar\"}"), "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null}");
check("empty batch", await exchange("[]"), "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null}");
check("invalid batch", await exchange("[1,2]"), "[{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null},{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null}]");
check("batch", await exchange("[{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": [1,2,4], \"id\": \"1\"}, {\"jsonrpc\": \"2.0\", \"method\": \"update\", \"params\": [7]}, {\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42,23], \"id\": \"2\"}, {\"foo\": \"boo\"}, {\"jsonrpc\": \"2.0\", \"method\": \"get_data\", \"id\": \"9\"}]"),
    "[{\"jsonrpc\":\"2.0\",\"result\":7,\"id\":\"1\"},{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":\"2\"},{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null},{\"jsonrpc\":\"2.0\",\"result\":[\"hello\",5],\"id\":\"9\"}]");
check("all notifications", await exchange("[{\"jsonrpc\": \"2.0\", \"method\": \"update\", \"params\": [1]}, {\"jsonrpc\": \"2.0\", \"method\": \"foobar\"}]"), "");
check("notes", len(notes), 4);
check("async handler", await exchange("{\"jsonrpc\":\"2.0\",\"method\":\"slow\",\"id\":7}"), "{\"jsonrpc\":\"2.0\",\"result\":\"later\",\"id\":7}");
check("runtime error", 字串.包含(await exchange("{\"jsonrpc\":\"2.0\",\"method\":\"boom\",\"id\":8}"), "\"code\":-32603"), true);
check("custom error", await exchange("{\"jsonrpc\":\"2.0\",\"method\":\"refuse\",\"id\":9}"), "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32050,\"message\":\"refused\",\"data\":{\"why\":\"test\"}},\"id\":9}");
check("rejected error", await exchange("{\"jsonrpc\":\"2.0\",\"method\":\"reject\",\"id\":10}"), "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32602,\"message\":\"need two numbers\"},\"id\":10}");
check("kinds", [rpc.Kind(rpc.Request("a", null, 1)), rpc.Kind(rpc.Notification("a", [1])), rpc.Kind(rpc.ResultResponse(1, 2)), rpc.Kind([]), rpc.Kind({"jsonrpc": "1.0", "method": "a"})],
    ["request", "notification", "response", "batch", "invalid"]);

# 雙向的一對端點：兩邊都能呼叫。 / A symmetric pair: both sides call.
var pair = rpc.CreatePair();
var client = pair[0];
var service = pair[1];
service.Handle("add", function(params) { return params[0] + params[1]; });
service.Handle("echo", async function(params, context) {
    # 處理中回頭呼叫對方。 / Call back into the other side while handling.
    var name = await context["endpoint"].Call("whoami", null);
    return "hello " + name + ": " + params["text"];
});
client.Handle("whoami", function(params) { return "client"; });
check("call", await client.Call("add", [2, 3]), 5);
check("call back", await client.Call("echo", {"text": "星泉"}), "hello client: 星泉");
var missing = await client.Call("nope", []).Catch(function(error) { return error; });
check("error object", [missing["code"], missing["message"]], [-32601, "Method not found"]);
var batch = await client.Batch([["add", [1, 1]], ["nope", null], ["add", [5, 5], true], ["add", [3, 4]]]);
check("batch results", [batch[0]["result"], batch[1]["error"]["code"], batch[2], batch[3]["result"]], [2, -32601, null, 7]);
var heard = [];
service.OnNotification("ping", function(params) { 陣列.追加(heard, params["n"]); });
client.Notify("ping", {"n": 1});
client.Notify("ping", {"n": 2});
for (var i = 0; i < 50 && len(heard) < 2; i++) { await 承諾.延遲(1); }
check("notifications in order", heard, [1, 2]);
check("pending", client.PendingCount(), 0);

# 逾時與關閉。 / Timeouts and closing.
service.Handle("never", function(params) { return 承諾.建立(function(resolve, reject) { 0; }); });
client.SetTimeout(30);
var late = await client.Call("never", null).Catch(function(error) { return error["code"]; });
check("timeout", late, -32000);
client.SetTimeout(0);
var waiting = client.Call("never", null);
client.Close();
check("closed", await waiting.Catch(function(error) { return error["code"]; }), -32001);
check("after close", await client.Call("add", [1, 2]).Catch(function(error) { return error["code"]; }), -32001);

# 分框（LSP 基本協定）。 / Framing (LSP's base protocol).
var reader = rpc.CreateFrameReader();
var framed = rpc.Frame("{\"a\":\"星\"}");
陣列.追加陣列(framed, rpc.Frame("{}"));
reader.Feed(陣列.切片(framed, 0, 10));
check("partial frame", len(reader.Take()), 0);
reader.Feed(陣列.切片(framed, 10, len(framed)));
check("frames", reader.Take(), ["{\"a\":\"星\"}", "{}"]);
check("frame header", 字串.開頭是(import("Network").BytesToText(rpc.Frame("{\"a\":\"星\"}")), "Content-Length: 11"), true);

if (len(failures) == 0) { print("JSONRPC_PROTOCOL_OK"); } else { print("JSONRPC_PROTOCOL_FAIL", failures); }
