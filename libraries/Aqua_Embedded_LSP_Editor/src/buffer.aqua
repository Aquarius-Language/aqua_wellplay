##
文字緩衝：以行為單位儲存文字，位置是 {行, 字元}（字元為 UTF-16 單位，與 LSP 相同），每次編輯都記錄成可復原的
變更，也是送給語言伺服器的增量變更。
The text buffer: lines of text, positions {line, character} (UTF-16 units, as LSP), and every edit recorded as an
undoable change that is also the incremental change sent to a language server.
##
var String = import("String");
var Array = import("Array");

struct Position { line; character }
struct Buffer { lines; version; undo; redo; groupTime }
# 一次編輯：範圍內的舊文字換成新文字。 / One edit: the old text of a range replaced by new text.
struct Change { start; end; text; oldText; newEnd }

var _newline = String.FromCode(10);

var Create = function(text) {
    var lines = String.Split(String.Replace(text, String.FromCode(13), ""), _newline);
    if (len(lines) == 0) { lines = [""]; }
    return Buffer(lines, 1, [], [], -1.0d);
};
var Text = function(buffer) { return String.Join(buffer.lines, _newline); };
var LineCount = function(buffer) { return len(buffer.lines); };
var Line = function(buffer, index) { return buffer.lines[index]; };
var Pos = function(line, character) { return Position(line, character); };

var Compare = function(a, b) {
    if (a.line != b.line) { return a.line - b.line; }
    return a.character - b.character;
};
var Clamp = function(buffer, p) {
    var line = p.line;
    if (line < 0) { return Position(0, 0); }
    if (line >= len(buffer.lines)) { return Position(len(buffer.lines) - 1, len(buffer.lines[len(buffer.lines) - 1])); }
    var character = p.character;
    if (character < 0) { character = 0; }
    if (character > len(buffer.lines[line])) { character = len(buffer.lines[line]); }
    return Position(line, character);
};
var End = function(buffer) { return Position(len(buffer.lines) - 1, len(buffer.lines[len(buffer.lines) - 1])); };

# 範圍內的文字。 / The text of a range.
var Slice = function(buffer, start, end) {
    if (Compare(start, end) > 0) { var t = start; start = end; end = t; }
    if (start.line == end.line) { return String.Slice(buffer.lines[start.line], start.character, end.character); }
    var parts = [String.Slice(buffer.lines[start.line], start.character, len(buffer.lines[start.line]))];
    for (var i = start.line + 1; i < end.line; i++) { Array.Append(parts, buffer.lines[i]); }
    Array.Append(parts, String.Slice(buffer.lines[end.line], 0, end.character));
    return String.Join(parts, _newline);
};

# 插入文字後的結束位置。 / Where inserted text ends.
var _endAfter = function(start, text) {
    var parts = String.Split(text, _newline);
    if (len(parts) == 1) { return Position(start.line, start.character + len(text)); }
    return Position(start.line + len(parts) - 1, len(parts[len(parts) - 1]));
};

var _apply = function(buffer, start, end, text) {
    var before = String.Slice(buffer.lines[start.line], 0, start.character);
    var after = String.Slice(buffer.lines[end.line], end.character, len(buffer.lines[end.line]));
    var parts = String.Split(String.Replace(text, String.FromCode(13), ""), _newline);
    parts[0] = before + parts[0];
    parts[len(parts) - 1] = parts[len(parts) - 1] + after;
    Array.Delete(buffer.lines, start.line, end.line + 1);
    var tail = Array.Slice(buffer.lines, start.line, len(buffer.lines));
    Array.Delete(buffer.lines, start.line, len(buffer.lines));
    Array.AppendArray(buffer.lines, parts);
    Array.AppendArray(buffer.lines, tail);
    buffer.version++;
};

# 以新文字取代範圍；回傳變更（給語言伺服器與復原）。相鄰的連續輸入會合併成一次復原。
# Replace a range with new text; returns the change (for the language server and undo). Consecutive typing within
# a second merges into one undo step.
var Edit = function(buffer, start, end, text) {
    start = Clamp(buffer, start);
    end = Clamp(buffer, end);
    if (Compare(start, end) > 0) { var t = start; start = end; end = t; }
    var oldText = Slice(buffer, start, end);
    _apply(buffer, start, end, text);
    var change = Change(start, end, text, oldText, _endAfter(start, text));
    var now = currentTime();
    var last = null;
    if (len(buffer.undo) > 0) { last = buffer.undo[len(buffer.undo) - 1]; }
    var typing = len(text) == 1 && oldText == "" && text != _newline && text != " ";
    if (typing && last != null && now - buffer.groupTime < 1000.0d && len(last) == 1 && last[0].oldText == ""
        && Compare(last[0].newEnd, start) == 0 && String.Find(last[0].text, _newline) < 0) {
        # 接在上一次輸入之後：合併。 / Right after the previous typing: merge.
        last[0] = Change(last[0].start, last[0].end, last[0].text + text, "", change.newEnd);
    } else {
        Array.Append(buffer.undo, [change]);
        if (len(buffer.undo) > 500) { Array.Delete(buffer.undo, 0, 1); }
    }
    buffer.groupTime = now;
    if (!typing) { buffer.groupTime = -1.0d; }
    buffer.redo = [];
    return change;
};

# 復原：回傳反向套用的變更陣列（給語言伺服器），以及游標應在的位置。 / Undo: the changes applied (for the language
# server) and where the cursor belongs.
var Undo = function(buffer) {
    if (len(buffer.undo) == 0) { return null; }
    var group = buffer.undo[len(buffer.undo) - 1];
    Array.Delete(buffer.undo, len(buffer.undo) - 1, len(buffer.undo));
    var applied = [];
    var cursor = null;
    for (var i = len(group) - 1; i >= 0; i -= 1) {
        var c = group[i];
        _apply(buffer, c.start, c.newEnd, c.oldText);
        Array.Append(applied, Change(c.start, c.newEnd, c.oldText, c.text, _endAfter(c.start, c.oldText)));
        cursor = _endAfter(c.start, c.oldText);
    }
    Array.Append(buffer.redo, group);
    buffer.groupTime = -1.0d;
    return {"changes": applied, "cursor": cursor};
};
var Redo = function(buffer) {
    if (len(buffer.redo) == 0) { return null; }
    var group = buffer.redo[len(buffer.redo) - 1];
    Array.Delete(buffer.redo, len(buffer.redo) - 1, len(buffer.redo));
    var applied = [];
    var cursor = null;
    for (var i = 0; i < len(group); i++) {
        var c = group[i];
        _apply(buffer, c.start, c.end, c.text);
        Array.Append(applied, c);
        cursor = c.newEnd;
    }
    Array.Append(buffer.undo, group);
    buffer.groupTime = -1.0d;
    return {"changes": applied, "cursor": cursor};
};

# 位置與文字索引互換（整份文字中的 UTF-16 位置）。 / Positions to and from offsets in the whole text.
var OffsetOf = function(buffer, p) {
    var offset = 0;
    for (var i = 0; i < p.line; i++) { offset += len(buffer.lines[i]) + 1; }
    return offset + p.character;
};
var PositionOf = function(buffer, offset) {
    for (var i = 0; i < len(buffer.lines); i++) {
        if (offset <= len(buffer.lines[i])) { return Position(i, offset); }
        offset -= len(buffer.lines[i]) + 1;
    }
    return End(buffer);
};

# 位置所在的字（識別字字元）範圍 [起, 終)。 / The word (identifier characters) around a position: [start, end).
var _isWord = function(c) { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || (c >= 48 && c <= 57) || c >= 128; };
var WordAt = function(buffer, p) {
    var line = buffer.lines[p.line];
    var start = p.character;
    var end = p.character;
    for (; start > 0 && _isWord(String.Code(line, start - 1)); start -= 1) { 0; }
    for (; end < len(line) && _isWord(String.Code(line, end)); end++) { 0; }
    return [start, end];
};
# 游標前的字首（自動完成用）。 / The word prefix before a position (for completion).
var PrefixAt = function(buffer, p) {
    var word = WordAt(buffer, p);
    return String.Slice(buffer.lines[p.line], word[0], p.character);
};
# 下一個／上一個字的邊界（Ctrl＋左右）。 / The next or previous word boundary (Ctrl+Left/Right).
var WordBoundary = function(buffer, p, direction) {
    var line = buffer.lines[p.line];
    var i = p.character;
    if (direction > 0) {
        if (i >= len(line)) { if (p.line + 1 < len(buffer.lines)) { return Position(p.line + 1, 0); } return p; }
        for (; i < len(line) && !_isWord(String.Code(line, i)); i++) { 0; }
        for (; i < len(line) && _isWord(String.Code(line, i)); i++) { 0; }
        return Position(p.line, i);
    }
    if (i == 0) { if (p.line > 0) { return Position(p.line - 1, len(buffer.lines[p.line - 1])); } return p; }
    for (; i > 0 && !_isWord(String.Code(line, i - 1)); i -= 1) { 0; }
    for (; i > 0 && _isWord(String.Code(line, i - 1)); i -= 1) { 0; }
    return Position(p.line, i);
};
# 行首縮排（空白與 Tab）。 / The leading indentation of a line.
var Indentation = function(buffer, line) {
    var text = buffer.lines[line];
    var i = 0;
    for (; i < len(text) && (String.Code(text, i) == 32 || String.Code(text, i) == 9); i++) { 0; }
    return String.Slice(text, 0, i);
};
