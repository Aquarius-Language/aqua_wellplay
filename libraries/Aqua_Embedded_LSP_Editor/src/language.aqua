##
AquariusLang 的語言知識：雙語關鍵字、型別名稱、內建函式與內建模組成員，附說明。內建語言伺服器與語法上色共用。
What the editor knows about AquariusLang: bilingual keywords, type names, builtins and built-in module members with
their descriptions. Shared by the built-in language server and the highlighter.
##

# [中文, English, 說明 / description]
var Keywords = [
    ["變數", "var", "變數 名稱 = 值; — Declare a variable. / 宣告變數。"],
    ["函式", "function", "函式(參數) { ... } — A function (closure). / 函式（閉包）。"],
    ["回傳", "return", "回傳 值; — Return from a function. / 從函式回傳。"],
    ["如果", "if", "如果 (條件) { ... } — Conditional. / 條件。"],
    ["否則如果", "elif", "否則如果 (條件) { ... } — Another branch; also else if. / 另一個分支。"],
    ["否則", "else", "否則 { ... } — Fallback branch. / 其他情況。"],
    ["迴圈", "for", "迴圈 (變數 i = 0; i < n; i++) { ... } — Loop. / 迴圈。"],
    ["中斷", "break", "中斷; — Leave the loop. / 離開迴圈。"],
    ["繼續", "continue", "繼續; — Next iteration. / 下一輪。"],
    ["真", "true", "Boolean true. / 布林真。"],
    ["假", "false", "Boolean false. / 布林假。"],
    ["空值", "null", "The null value. / 空值。"],
    ["結構", "struct", "結構 名稱 { 欄位: 型別 } — Declare a struct type. / 宣告結構。"],
    ["非同步", "async", "非同步 函式(...) { ... } — An async function: returns a promise, may await. / 非同步函式：回傳承諾，可以等待。"],
    ["等待", "await", "等待 承諾 — Wait for a promise inside an async function or at the top level. / 在非同步函式或最上層等待承諾。"]
];

var TypeNames = ["整數", "int", "浮點數", "float", "雙精度", "double", "布林", "bool", "字串", "string", "陣列", "array"];

# [中文, English, 參數 / parameters, 說明 / description]
var Builtins = [
    ["印出", "print", "values...", "Print values. / 印出值。"],
    ["匯入", "import", "name", "Import a library module or a script. / 匯入模組或腳本。"],
    ["長度", "len", "value", "Length of a string, array or hash. / 長度。"],
    ["型別", "typeOf", "value", "The value's type tag. / 值的型別。"],
    ["參數個數", "arityOf", "function", "Parameters a function declares. / 函式宣告的參數個數。"],
    ["加入", "push", "array, value", "A copy with a value appended. / 附加值的新陣列。"],
    ["最後一個", "last", "array", "The last element. / 最後一個元素。"],
    ["其餘", "rest", "array", "All but the first element. / 第一個以外的元素。"],
    ["目前時間", "currentTime", "", "Monotonic milliseconds. / 單調時間（毫秒）。"],
    ["目前日期", "currentDate", "", "Today as yyyy-MM-dd. / 今天的日期。"],
    ["整數", "int", "number", "Convert to an integer. / 轉成整數。"],
    ["浮點數", "float", "number", "Convert to a float. / 轉成浮點數。"],
    ["雙精度", "double", "number", "Convert to a double. / 轉成雙精度。"],
    ["是網頁", "isWeb", "", "Whether this runs in a browser. / 是否在網頁執行。"],
    ["是Android", "isOSAndroid", "", "Whether this runs on Android. / 是否在 Android 執行。"],
    ["是Windows", "isOSWindows", "", "Whether this runs on Windows. / 是否在 Windows 執行。"],
    ["是Linux", "isOSLinux", "", "Whether this runs on Linux. / 是否在 Linux 執行。"]
];

# 內建模組：[名稱們, 成員們]，成員為 [中文, English, 參數, 說明]。 / Built-in modules: [names, members].
var Modules = [
    [["承諾", "Promise"], [
        ["建立", "New", "function(resolve, reject)", "A promise its executor settles. / 由執行函式決定的承諾。"],
        ["解決", "Resolve", "value", "A fulfilled promise. / 已完成的承諾。"],
        ["拒絕", "Reject", "reason", "A rejected promise. / 已拒絕的承諾。"],
        ["全部", "All", "promises", "All values in order. / 全部的值。"],
        ["全部結算", "AllSettled", "promises", "Every outcome. / 每個結果。"],
        ["競速", "Race", "promises", "The first to settle. / 最先完成者。"],
        ["任一", "Any", "promises", "The first fulfilled value. / 第一個完成的值。"],
        ["延遲", "Delay", "milliseconds, value?", "Fulfilled after a delay. / 延遲後完成。"],
        ["逾時", "Timeout", "promise, milliseconds", "Rejects when time runs out. / 逾時即拒絕。"],
        ["是承諾", "IsPromise", "value", "Whether a value is a promise. / 是否為承諾。"]]],
    [["陣列", "Array"], [
        ["建立", "Make", "length, value", "A new array. / 建立陣列。"],
        ["追加", "Append", "array, value", "Append in place. / 原地追加。"],
        ["追加陣列", "AppendArray", "array, source", "Append many in place. / 批次追加。"],
        ["切片", "Slice", "array, start, end", "A copy of [start, end). / 切片。"],
        ["刪除", "Delete", "array, start, end", "Remove [start, end). / 刪除。"],
        ["尋找", "Index", "array, value", "First index or -1. / 第一個位置。"],
        ["包含", "Contains", "array, value", "Whether it holds a value. / 是否包含。"],
        ["排序", "Sort", "array, compare?", "Stable sort in place. / 原地排序。"],
        ["映射", "Map", "array, function", "A mapped copy. / 映射。"],
        ["篩選", "Filter", "array, function", "A filtered copy. / 篩選。"],
        ["歸約", "Reduce", "array, function, initial", "Fold from the left. / 歸約。"],
        ["總和", "Sum", "array", "The sum. / 總和。"],
        ["克隆", "Clone", "array", "A shallow copy. / 淺拷貝。"],
        ["反轉", "Reverse", "array", "Reverse in place. / 反轉。"]]],
    [["字串", "String"], [
        ["轉文字", "From", "value", "Text of a value. / 轉成文字。"],
        ["切片", "Slice", "text, start, end", "A part of the text. / 切片。"],
        ["尋找", "Find", "text, part", "First index or -1. / 第一個位置。"],
        ["包含", "Contains", "text, part", "Whether text contains part. / 是否包含。"],
        ["開頭是", "StartsWith", "text, prefix", "Starts with a prefix. / 是否以前綴開頭。"],
        ["結尾是", "EndsWith", "text, suffix", "Ends with a suffix. / 是否以後綴結尾。"],
        ["分割", "Split", "text, separator", "Split into parts. / 分割。"],
        ["合併", "Join", "array, separator", "Join parts. / 合併。"],
        ["取代", "Replace", "text, old, new", "Replace every occurrence. / 全部取代。"],
        ["修剪", "Trim", "text", "Without surrounding spaces. / 去除前後空白。"],
        ["轉大寫", "Upper", "text", "Upper case. / 轉大寫。"],
        ["轉小寫", "Lower", "text", "Lower case. / 轉小寫。"],
        ["解析整數", "ParseInt", "text", "An integer or null. / 解析整數。"]]],
    [["雜湊", "Hash"], [
        ["鍵列表", "Keys", "hash", "The keys. / 所有鍵。"],
        ["值列表", "Values", "hash", "The values. / 所有值。"],
        ["包含鍵", "Has", "hash, key", "Whether a key exists. / 是否有鍵。"],
        ["取得", "Get", "hash, key, default", "A value or the default. / 取值或預設值。"],
        ["刪除鍵", "Delete", "hash, key", "Remove a key. / 刪除鍵。"],
        ["克隆", "Clone", "hash", "A shallow copy. / 淺拷貝。"],
        ["合併", "Merge", "destination, source", "Copy entries over. / 合併。"]]],
    [["執行緒", "Thread"], [
        ["啟動", "Start", "function, arguments?", "Start a worker. / 啟動工作。"],
        ["等待", "Wait", "handle, timeout?", "Wait for a worker. / 等待工作。"],
        ["結果", "Result", "handle", "A worker's result. / 工作結果。"],
        ["休眠", "Sleep", "milliseconds", "Sleep. / 休眠。"]]]
];

# 常見函式庫模組（以 匯入 取得）的名稱。 / Names of common library modules (through import).
var LibraryModules = ["Network", "網路", "Processing", "繪圖", "Interaction", "互動", "Serialization", "序列化",
    "Files", "Clipboard", "Audio", "AquaJSONRPC", "AquaWebSocket", "AquaEditor"];

# 程式片段：[前綴, 說明, 內容（$1 $0 為游標位置）]。 / Snippets: [prefix, description, body with $1 / $0 stops].
var Snippets = [
    ["function", "var name = function(params) { ... }", "var ${1:name} = function(${2}) {\n    $0\n};"],
    ["函式", "變數 名稱 = 函式(參數) { ... }", "變數 ${1:名稱} = 函式(${2}) {\n    $0\n};"],
    ["async", "var name = async function(params) { ... }", "var ${1:name} = async function(${2}) {\n    $0\n};"],
    ["非同步", "變數 名稱 = 非同步 函式(參數) { ... }", "變數 ${1:名稱} = 非同步 函式(${2}) {\n    $0\n};"],
    ["for", "for (var i = 0; i < n; i++) { ... }", "for (var ${1:i} = 0; $1 < ${2:n}; $1++) {\n    $0\n}"],
    ["迴圈", "迴圈 (變數 i = 0; i < n; i++) { ... }", "迴圈 (變數 ${1:i} = 0; $1 < ${2:n}; $1++) {\n    $0\n}"],
    ["if", "if (condition) { ... }", "if (${1:condition}) {\n    $0\n}"],
    ["如果", "如果 (條件) { ... }", "如果 (${1:條件}) {\n    $0\n}"],
    ["struct", "struct Name { field }", "struct ${1:Name} { ${2:field} }"]
];

# 程式片段裡的 \n 是換行（字串字面值本身不轉義）。 / The \n of snippets are newlines (literals keep them as written).
for (var i = 0; i < len(Snippets); i++) { Snippets[i][2] = import("String").Replace(Snippets[i][2], "\\n", import("String").FromCode(10)); }

# 一個字是否為關鍵字（任一語言）；回傳 Keywords 的項目或 null。 / A keyword entry by either spelling, or null.
var Keyword = function(word) {
    for (var i = 0; i < len(Keywords); i++) {
        if (Keywords[i][0] == word || Keywords[i][1] == word) { return Keywords[i]; }
    }
    return null;
};
var Builtin = function(word) {
    for (var i = 0; i < len(Builtins); i++) {
        if (Builtins[i][0] == word || Builtins[i][1] == word) { return Builtins[i]; }
    }
    return null;
};
var Module = function(word) {
    for (var i = 0; i < len(Modules); i++) {
        if (Modules[i][0][0] == word || Modules[i][0][1] == word) { return Modules[i]; }
    }
    return null;
};
var IsTypeName = function(word) { return import("Array").Contains(TypeNames, word); };
