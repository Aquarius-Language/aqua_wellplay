##
AquariusLang 語法上色：把每一行切成記號 [起點, 終點, 種類]（UTF-16 位置，與 LSP 相同）。區塊註解（兩個井號之間）與跨行字串
會延續到下一行。種類：keyword、constant、type、string、number、comment、function、builtin、module、property、
identifier、operator、punctuation。
AquariusLang highlighting: each line becomes tokens [start, end, kind] (UTF-16 positions, as LSP). Block comments
(between two double hashes) and multi-line strings carry over to the next line.
##
var String = import("String");
var Array = import("Array");
var language = null;
var Initialize = function(languageModule) { language = languageModule; };

var _isDigit = function(c) { return c >= 48 && c <= 57; };
var _isWord = function(c) { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || _isDigit(c) || c >= 128; };
var _isSpace = function(c) { return c == 32 || c == 9 || c == 13; };
var _operators = "+-*/%=<>!&|.?";

# 位置 i 之後第一個非空白字元，沒有則 -1。 / The first non-space character from i, or -1.
var _nextCode = function(line, i) {
    for (var k = i; k < len(line); k++) {
        var c = String.Code(line, k);
        if (!_isSpace(c)) { return c; }
    }
    return -1;
};
var _previousCode = function(line, i) {
    for (var k = i - 1; k >= 0; k -= 1) {
        var c = String.Code(line, k);
        if (!_isSpace(c)) { return c; }
    }
    return -1;
};

var _classify = function(word, line, start, end) {
    var entry = language.Keyword(word);
    if (entry != null) {
        if (word == "真" || word == "假" || word == "空值" || word == "true" || word == "false" || word == "null") { return "constant"; }
        return "keyword";
    }
    var before = _previousCode(line, start);
    if (before == 58 && language.IsTypeName(word)) { return "type"; }
    if (before == 46) {
        if (_nextCode(line, end) == 40) { return "function"; }
        return "property";
    }
    if (language.Builtin(word) != null) { return "builtin"; }
    if (language.Module(word) != null || Array.Contains(language.LibraryModules, word)) { return "module"; }
    if (_nextCode(line, end) == 40) { return "function"; }
    return "identifier";
};

# 一行的記號；狀態是 "" 或上一行留下的 "comment" / "string"。回傳 {"tokens", "state"}。
# The tokens of a line from the state the previous line left ("", "comment" or "string"); returns {"tokens", "state"}.
var TokenizeLine = function(line, state) {
    var tokens = [];
    var n = len(line);
    var i = 0;
    if (state == "comment") {
        var close = String.Find(line, "##");
        if (close < 0) { Array.Append(tokens, [0, n, "comment"]); return {"tokens": tokens, "state": "comment"}; }
        Array.Append(tokens, [0, close + 2, "comment"]);
        i = close + 2;
        state = "";
    }
    if (state == "string") {
        var j = 0;
        var closed = false;
        for (; j < n; j++) {
            var c = String.Code(line, j);
            if (c == 92) { j++; continue; }
            if (c == 34) { closed = true; break; }
        }
        if (!closed) { Array.Append(tokens, [0, n, "string"]); return {"tokens": tokens, "state": "string"}; }
        Array.Append(tokens, [0, j + 1, "string"]);
        i = j + 1;
        state = "";
    }
    for (; i < n;) {
        var c = String.Code(line, i);
        if (_isSpace(c)) { i++; continue; }
        if (c == 35) {
            if (i + 1 < n && String.Code(line, i + 1) == 35) {
                var rest = String.Find(String.Slice(line, i + 2, n), "##");
                if (rest < 0) { Array.Append(tokens, [i, n, "comment"]); return {"tokens": tokens, "state": "comment"}; }
                Array.Append(tokens, [i, i + 4 + rest, "comment"]);
                i = i + 4 + rest;
                continue;
            }
            Array.Append(tokens, [i, n, "comment"]);
            return {"tokens": tokens, "state": ""};
        }
        if (c == 34) {
            var j = i + 1;
            var closed = false;
            for (; j < n; j++) {
                var d = String.Code(line, j);
                if (d == 92) { j++; continue; }
                if (d == 34) { closed = true; break; }
            }
            if (!closed) { Array.Append(tokens, [i, n, "string"]); return {"tokens": tokens, "state": "string"}; }
            Array.Append(tokens, [i, j + 1, "string"]);
            i = j + 1;
            continue;
        }
        if (_isDigit(c)) {
            var j = i + 1;
            for (; j < n; j++) {
                var d = String.Code(line, j);
                if (!(_isDigit(d) || d == 46 || d == 102 || d == 100)) { break; }
            }
            Array.Append(tokens, [i, j, "number"]);
            i = j;
            continue;
        }
        if (_isWord(c)) {
            var j = i + 1;
            for (; j < n; j++) {
                var d = String.Code(line, j);
                if (!_isWord(d)) { break; }
                if (d > 65535) { j++; }
            }
            var word = String.Slice(line, i, j);
            Array.Append(tokens, [i, j, _classify(word, line, i, j)]);
            i = j;
            continue;
        }
        if (String.Contains(_operators, String.FromCode(c))) {
            var j = i + 1;
            for (; j < n && String.Contains(_operators, String.FromCode(String.Code(line, j))) && String.Code(line, j) != 46; j++) { 0; }
            if (c == 46) { j = i + 1; }
            Array.Append(tokens, [i, j, "operator"]);
            i = j;
            continue;
        }
        Array.Append(tokens, [i, i + 1, "punctuation"]);
        i++;
    }
    return {"tokens": tokens, "state": state};
};

# 整份文件的記號，每行一個陣列。 / Tokens of a whole document, one array per line.
var Tokenize = function(lines) {
    var result = [];
    var state = "";
    for (var i = 0; i < len(lines); i++) {
        var line = TokenizeLine(lines[i], state);
        Array.Append(result, line["tokens"]);
        state = line["state"];
    }
    return result;
};
