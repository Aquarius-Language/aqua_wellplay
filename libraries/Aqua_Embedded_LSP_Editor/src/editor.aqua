##
編輯器本體：與繪圖無關。輸入是「互動」函式庫的事件（點擊次數、拖曳、捲動、鍵盤命令、右鍵選單），輸出是可以用任何
繪圖函式庫畫出的繪製模型（行、上色片段、游標、選取、診斷、自動完成、說明）。語言功能來自 LSP 用戶端。
The editor itself, independent of graphics: input is Interaction events (clicks with counts, drags, scrolling,
keyboard commands, context menus), output is a render model any graphics library can draw (lines, colored runs, the
caret, selections, diagnostics, completion, hover). Language features come from an LSP client.
##
var String = import("String");
var Array = import("Array");
var Hash = import("Hash");
var ScrollView = import("ScrollView");
var ContextMenu = import("ContextMenu");
var Interaction = import("Interaction");
var TextEditing = import("TextEditing");
var _apple = Interaction.Conventions().primaryModifier == "Cmd";
var buffers = null;
var highlight = null;
var Initialize = function(bufferModule, highlightModule) { buffers = bufferModule; highlight = highlightModule; };

struct Editor {
    buffer; cursor; anchor; preferredX;
    view; lineHeight; charWidth; measure; padding; tabText;
    tokens; tokensVersion; maxWidth;
    diagnostics; completion; hover; signature;
    client; uri; languageId; sentVersion;
    focused; blinkStart; blinkTime; readOnly;
    clipboard; onChange; onCommand; menu; dragging; lastClick;
    pointerX; pointerY; pointerTime; hoverAsked; theme; autoClose;
    session; textInput; textRect; composition; compositionCursor; areaName; areaKey; overwrite; kill
}
var _editorCount = 0;

var _newline = String.FromCode(10);
# 以 "鍵" 取雜湊表成員（struct 欄位上的雜湊表不能直接 ["鍵"](...) 呼叫）。 / A hash member, for calling one held in a field.
var _member = function(table, name) { return table[name]; };
# 不超出範圍的切片。 / A slice clamped to the text.
var _slice = function(text, start, end) {
    if (end > len(text)) { end = len(text); }
    if (start > end) { return ""; }
    return String.Slice(text, start, end);
};

# 預設的主題（RGB）：語法種類與介面顏色。 / The default themes (RGB): token kinds and interface colors.
var LightTheme = {
    "background": [255, 255, 255], "text": [36, 41, 47], "gutter": [246, 248, 250], "lineNumber": [140, 149, 159],
    "currentLine": [244, 247, 252], "selection": [184, 214, 252], "caret": [36, 41, 47],
    "keyword": [207, 34, 46], "constant": [5, 80, 174], "type": [130, 80, 223], "string": [10, 48, 105],
    "number": [5, 80, 174], "comment": [106, 115, 125], "function": [130, 80, 223], "builtin": [149, 56, 0],
    "module": [149, 56, 0], "property": [5, 80, 174], "identifier": [36, 41, 47], "operator": [207, 34, 46],
    "punctuation": [36, 41, 47], "error": [207, 34, 46], "warning": [191, 135, 0], "information": [5, 80, 174],
    "popup": [255, 255, 255], "popupBorder": [208, 215, 222], "popupSelected": [221, 236, 255]
};
var DarkTheme = {
    "background": [30, 30, 30], "text": [212, 212, 212], "gutter": [37, 37, 38], "lineNumber": [133, 133, 133],
    "currentLine": [40, 40, 42], "selection": [38, 79, 120], "caret": [174, 175, 173],
    "keyword": [197, 134, 192], "constant": [86, 156, 214], "type": [78, 201, 176], "string": [206, 145, 120],
    "number": [181, 206, 168], "comment": [106, 153, 85], "function": [220, 220, 170], "builtin": [86, 156, 214],
    "module": [78, 201, 176], "property": [156, 220, 254], "identifier": [156, 220, 254], "operator": [212, 212, 212],
    "punctuation": [212, 212, 212], "error": [244, 71, 71], "warning": [205, 173, 0], "information": [55, 148, 255],
    "popup": [37, 37, 38], "popupBorder": [69, 69, 69], "popupSelected": [4, 57, 94]
};

# ---- 建立與文字 / Creating and text ----
var Create = function(options) {
    var opt = function(english, chinese, fallback) {
        if (options == null) { return fallback; }
        if (options[english] != null) { return options[english]; }
        if (options[chinese] != null) { return options[chinese]; }
        return fallback;
    };
    var conventions = Interaction.Conventions();
    var theme = LightTheme;
    if (conventions.darkMode) { theme = DarkTheme; }
    var editor = Editor(buffers.Create(opt("text", "文字", "")), buffers.Pos(0, 0), null, -1.0d,
        ScrollView.Create(0, 0, 400, 300, 400, 300), opt("lineHeight", "行高", 20) * 1.0d, opt("charWidth", "字寬", 8) * 1.0d,
        opt("measure", "量測", null), 6.0d, String.Repeat(" ", opt("tabSize", "縮排寬度", 4)),
        null, -1, 0.0d, [], null, null, null,
        null, opt("uri", "網址", "inmemory://editor/main.aqua"), opt("languageId", "語言", "aquarius"), 0,
        true, 0.0d, conventions.caretBlinkTime * 1.0d, opt("readOnly", "唯讀", false),
        opt("clipboard", "剪貼簿", null), null, null, null, false, [0.0d, -1, -1, 0],
        -1.0d, -1.0d, 0.0d, false, opt("theme", "主題", theme), opt("autoClose", "自動配對", true),
        null, false, "", "", 0, "", "", false, "");
    _editorCount++;
    editor.areaName = "editor" + String.From(_editorCount);
    editor.menu = ContextMenu.Create(function(command) { RunCommand(editor, command); });
    _layoutContent(editor);
    return editor;
};

var Text = function(editor) { return buffers.Text(editor.buffer); };
var LineCount = function(editor) { return buffers.LineCount(editor.buffer); };
var OnChange = function(editor, callback) { editor.onChange = callback; };
# 編輯器不處理的命令（儲存、開啟、新增...）交給它。 / Commands the editor does not handle (save, open, new...).
var OnCommand = function(editor, callback) { editor.onCommand = callback; };
var SetTheme = function(editor, theme) { editor.theme = theme; };
var SetReadOnly = function(editor, readOnly) { editor.readOnly = readOnly; };

# 整份換掉（例如載入檔案）。 / Replace everything (loading a file).
var SetText = function(editor, text) {
    var change = buffers.Edit(editor.buffer, buffers.Pos(0, 0), buffers.End(editor.buffer), text);
    editor.cursor = buffers.Pos(0, 0);
    editor.anchor = null;
    _changed(editor, [change]);
};

# ---- 版面 / Layout ----
var _isWide = function(c) { return c >= 4352; };
# 一段文字的寬度：有 量測 函式時用它，否則等寬字型（全形字兩格）。 / Width of text: the measure function, or a
# monospace font where wide (CJK) characters take two cells.
var TextWidth = function(editor, text) {
    if (editor.measure != null) { return editor.measure(text) * 1.0d; }
    var width = 0.0d;
    for (var i = 0; i < len(text); i++) {
        var c = String.Code(text, i);
        if (c > 65535) { i++; width += editor.charWidth * 2.0d; continue; }
        if (c == 9) { width += editor.charWidth * len(editor.tabText); continue; }
        if (_isWide(c)) { width += editor.charWidth * 2.0d; } else { width += editor.charWidth; }
    }
    return width;
};
var GutterWidth = function(editor) {
    return TextWidth(editor, String.From(LineCount(editor))) + editor.padding * 3.0d;
};
var _layoutContent = function(editor) {
    var widest = 0.0d;
    for (var i = 0; i < LineCount(editor); i++) {
        var w = TextWidth(editor, buffers.Line(editor.buffer, i));
        if (w > widest) { widest = w; }
    }
    editor.maxWidth = widest;
    ScrollView.SetContentSize(editor.view, widest + GutterWidth(editor) + editor.padding * 2.0d + editor.charWidth * 4.0d,
        LineCount(editor) * editor.lineHeight + editor.lineHeight);
};
# 編輯器在視窗中的位置與大小。 / Where the editor is in the window and its size.
var Place = function(editor, left, top, width, height) {
    ScrollView.Place(editor.view, left, top, width, height);
    _layoutContent(editor);
};

# 位置的視窗座標（游標左上角）。 / The window coordinates of a position (the caret's top left).
var PointOf = function(editor, p) {
    var line = buffers.Line(editor.buffer, p.line);
    var x = editor.view.left + GutterWidth(editor) + editor.padding + TextWidth(editor, String.Slice(line, 0, p.character)) - editor.view.x;
    var y = editor.view.top + p.line * editor.lineHeight - editor.view.y;
    return [x, y];
};
# 視窗座標所在的位置。 / The position at window coordinates.
var PositionAt = function(editor, x, y) {
    var line = int((y - editor.view.top + editor.view.y) / editor.lineHeight);
    if (line < 0) { line = 0; }
    if (line >= LineCount(editor)) { line = LineCount(editor) - 1; }
    var text = buffers.Line(editor.buffer, line);
    var target = x - editor.view.left - GutterWidth(editor) - editor.padding + editor.view.x;
    var previous = 0.0d;
    for (var i = 0; i < len(text); i++) {
        var next = TextWidth(editor, String.Slice(text, 0, i + 1));
        if (target < (previous + next) / 2.0d) { return buffers.Pos(line, i); }
        previous = next;
    }
    return buffers.Pos(line, len(text));
};

var _reveal = function(editor) {
    var point = PointOf(editor, editor.cursor);
    var contentX = point[0] - editor.view.left + editor.view.x;
    var contentY = point[1] - editor.view.top + editor.view.y;
    ScrollView.ScrollIntoView(editor.view, contentX - GutterWidth(editor) - editor.charWidth, contentY, GutterWidth(editor) + editor.charWidth * 3.0d, editor.lineHeight);
};

# ---- 選取 / Selection ----
var HasSelection = function(editor) { return editor.anchor != null && buffers.Compare(editor.anchor, editor.cursor) != 0; };
var SelectionRange = function(editor) {
    if (!HasSelection(editor)) { return [editor.cursor, editor.cursor]; }
    if (buffers.Compare(editor.anchor, editor.cursor) < 0) { return [editor.anchor, editor.cursor]; }
    return [editor.cursor, editor.anchor];
};
var SelectedText = function(editor) {
    var range = SelectionRange(editor);
    return buffers.Slice(editor.buffer, range[0], range[1]);
};
var Select = function(editor, start, end) {
    editor.anchor = buffers.Clamp(editor.buffer, start);
    editor.cursor = buffers.Clamp(editor.buffer, end);
    editor.preferredX = -1.0d;
    _restartBlink(editor);
};
var SelectAll = function(editor) { Select(editor, buffers.Pos(0, 0), buffers.End(editor.buffer)); };
var SetCursor = function(editor, p, extend) {
    if (extend) { if (editor.anchor == null) { editor.anchor = editor.cursor; } }
    else { editor.anchor = null; }
    editor.cursor = buffers.Clamp(editor.buffer, p);
    _restartBlink(editor);
    _reveal(editor);
};
var _restartBlink = function(editor) { editor.blinkStart = currentTime(); };

# ---- 編輯 / Editing ----
var _changed = function(editor, changes) {
    editor.tokens = null;
    _layoutContent(editor);
    _reveal(editor);
    _restartBlink(editor);
    if (editor.client != null) { _member(editor.client, "changed")(changes); }
    if (editor.onChange != null) { editor.onChange(Text(editor)); }
};

# 在游標處（取代選取）插入文字。 / Insert text at the cursor, replacing the selection.
var Insert = function(editor, text) {
    if (editor.readOnly) { return false; }
    var range = SelectionRange(editor);
    var change = buffers.Edit(editor.buffer, range[0], range[1], text);
    editor.anchor = null;
    editor.cursor = change.newEnd;
    editor.preferredX = -1.0d;
    _changed(editor, [change]);
    return true;
};
var DeleteRange = function(editor, start, end) {
    if (editor.readOnly) { return false; }
    var change = buffers.Edit(editor.buffer, start, end, "");
    editor.anchor = null;
    editor.cursor = change.start;
    _changed(editor, [change]);
    return true;
};

var _pairs = {"(": ")", "[": "]", "{": "}", "\"": "\""};
# 打字：自動配對括號與引號、跳過已有的右括號。 / Typing: auto-close brackets and quotes, step over closers.
var Type = function(editor, text) {
    if (editor.readOnly) { return false; }
    if (len(text) == 1 && editor.autoClose && !HasSelection(editor)) {
        var line = buffers.Line(editor.buffer, editor.cursor.line);
        var next = _slice(line, editor.cursor.character, editor.cursor.character + 1);
        if ((text == ")" || text == "]" || text == "}" || text == "\"") && next == text) {
            SetCursor(editor, buffers.Pos(editor.cursor.line, editor.cursor.character + 1), false);
            _afterTyping(editor, text);
            return true;
        }
        var close = _pairs[text];
        if (close != null && (next == "" || next == " " || next == ")" || next == "]" || next == "}" || next == ";")) {
            Insert(editor, text + close);
            SetCursor(editor, buffers.Pos(editor.cursor.line, editor.cursor.character - 1), false);
            _afterTyping(editor, text);
            return true;
        }
    }
    # Insert 切換的覆寫模式：取代游標後的字元（不跨行）。 / Overwrite mode (Insert toggles it): replace the character
    # after the caret (never the line break).
    if (editor.overwrite && !HasSelection(editor) && len(text) == 1) {
        var here = buffers.Line(editor.buffer, editor.cursor.line);
        if (editor.cursor.character < len(here)) {
            editor.anchor = buffers.Pos(editor.cursor.line, TextEditing.Next(here, editor.cursor.character));
        }
    }
    Insert(editor, text);
    _afterTyping(editor, text);
    return true;
};

# Enter：保持縮排，在 { 之後多縮一層，{} 之間分成三行。 / Enter keeps the indentation, indents after {, and splits {}.
var NewLine = function(editor) {
    var indent = buffers.Indentation(editor.buffer, editor.cursor.line);
    var line = buffers.Line(editor.buffer, editor.cursor.line);
    var before = String.Trim(String.Slice(line, 0, editor.cursor.character));
    var after = _slice(line, editor.cursor.character, editor.cursor.character + 1);
    if (String.EndsWith(before, "{") || String.EndsWith(before, "(") || String.EndsWith(before, "[")) {
        if (after == "}" || after == ")" || after == "]") {
            Insert(editor, _newline + indent + editor.tabText + _newline + indent);
            SetCursor(editor, buffers.Pos(editor.cursor.line - 1, len(indent) + len(editor.tabText)), false);
            return true;
        }
        return Insert(editor, _newline + indent + editor.tabText);
    }
    return Insert(editor, _newline + indent);
};

var Backspace = function(editor) {
    if (HasSelection(editor)) { var r = SelectionRange(editor); return DeleteRange(editor, r[0], r[1]); }
    var p = editor.cursor;
    if (p.character == 0 && p.line == 0) { return false; }
    if (p.character == 0) { return DeleteRange(editor, buffers.Pos(p.line - 1, len(buffers.Line(editor.buffer, p.line - 1))), p); }
    var line = buffers.Line(editor.buffer, p.line);
    # 刪掉一個縮排單位；刪掉空的配對括號。 / Remove one indent unit; remove an empty bracket pair.
    var head = String.Slice(line, 0, p.character);
    if (String.Trim(head) == "" && p.character >= len(editor.tabText) && p.character % len(editor.tabText) == 0) {
        return DeleteRange(editor, buffers.Pos(p.line, p.character - len(editor.tabText)), p);
    }
    var previous = String.Slice(line, p.character - 1, p.character);
    var next = _slice(line, p.character, p.character + 1);
    if (_pairs[previous] != null && _pairs[previous] == next) { return DeleteRange(editor, buffers.Pos(p.line, p.character - 1), buffers.Pos(p.line, p.character + 1)); }
    var step = 1;
    if (p.character >= 2 && String.Code(line, p.character - 1) >= 56320 && String.Code(line, p.character - 1) <= 57343) { step = 2; }
    return DeleteRange(editor, buffers.Pos(p.line, p.character - step), p);
};
var DeleteForward = function(editor) {
    if (HasSelection(editor)) { var r = SelectionRange(editor); return DeleteRange(editor, r[0], r[1]); }
    var p = editor.cursor;
    var line = buffers.Line(editor.buffer, p.line);
    if (p.character >= len(line)) {
        if (p.line + 1 >= LineCount(editor)) { return false; }
        return DeleteRange(editor, p, buffers.Pos(p.line + 1, 0));
    }
    return DeleteRange(editor, p, buffers.Pos(p.line, p.character + 1));
};
# Tab：有選取時整段縮排，Shift＋Tab 取消縮排。 / Tab indents the selected lines; Shift+Tab outdents.
var Indent = function(editor, outdent) {
    if (!HasSelection(editor) && !outdent) { return Insert(editor, editor.tabText); }
    var range = SelectionRange(editor);
    var changes = [];
    for (var l = range[0].line; l <= range[1].line; l++) {
        if (outdent) {
            var indent = buffers.Indentation(editor.buffer, l);
            var remove = len(indent);
            if (remove > len(editor.tabText)) { remove = len(editor.tabText); }
            if (remove > 0) { Array.Append(changes, buffers.Edit(editor.buffer, buffers.Pos(l, 0), buffers.Pos(l, remove), "")); }
        } else { Array.Append(changes, buffers.Edit(editor.buffer, buffers.Pos(l, 0), buffers.Pos(l, 0), editor.tabText)); }
    }
    if (HasSelection(editor)) { editor.anchor = buffers.Pos(range[0].line, 0); editor.cursor = buffers.Pos(range[1].line, len(buffers.Line(editor.buffer, range[1].line))); }
    _changed(editor, changes);
    return true;
};

# ---- 命令 / Commands ----
# 系統剪貼簿用「互動」的同步文字剪貼簿，與其他 UI 的文字欄位相同。 / The system clipboard through Interaction's immediate
# text clipboard, as every UI library's text fields use it.
var _clipboardWrite = function(editor, text) {
    if (editor.clipboard != null) { _member(editor.clipboard, "set")(text); return true; }
    return Interaction.SetClipboardText(text);
};
var _clipboardRead = function(editor) {
    if (editor.clipboard != null) { return _member(editor.clipboard, "get")(); }
    var text = Interaction.ClipboardText();
    if (text == null) { return ""; }
    return text;
};

var Undo = function(editor) {
    var done = buffers.Undo(editor.buffer);
    if (done == null) { return false; }
    editor.anchor = null;
    editor.cursor = done["cursor"];
    _changed(editor, done["changes"]);
    return true;
};
var Redo = function(editor) {
    var done = buffers.Redo(editor.buffer);
    if (done == null) { return false; }
    editor.anchor = null;
    editor.cursor = done["cursor"];
    _changed(editor, done["changes"]);
    return true;
};

# 「互動」的命令名稱：copy、cut、paste、undo、redo、selectAll、delete、cancel...；其他交給 OnCommand。
# Interaction command names; the rest go to OnCommand.
var RunCommand = function(editor, command) {
    # 沒有選取時複製／剪下整行（含換行），如 VS Code。 / Without a selection, copy or cut the whole line (with its line
    # break), as VS Code does.
    if (command == "copy") {
        if (HasSelection(editor)) { _clipboardWrite(editor, SelectedText(editor)); }
        else { _clipboardWrite(editor, buffers.Line(editor.buffer, editor.cursor.line) + _newline); }
        return true;
    }
    if (command == "cut") {
        if (editor.readOnly) { return true; }
        if (HasSelection(editor)) { _clipboardWrite(editor, SelectedText(editor)); var r = SelectionRange(editor); DeleteRange(editor, r[0], r[1]); }
        else { _clipboardWrite(editor, buffers.Line(editor.buffer, editor.cursor.line) + _newline); DeleteLines(editor); }
        return true;
    }
    if (command == "paste") { var text = _clipboardRead(editor); if (text != "") { Insert(editor, text); } return true; }
    if (command == "undo") { Undo(editor); return true; }
    if (command == "redo") { Redo(editor); return true; }
    if (command == "selectAll") { SelectAll(editor); return true; }
    if (command == "delete") { DeleteForward(editor); return true; }
    if (command == "cancel") {
        if (editor.completion != null || editor.hover != null || editor.signature != null) { editor.completion = null; editor.hover = null; editor.signature = null; return true; }
        if (HasSelection(editor)) { editor.anchor = null; return true; }
        return false;
    }
    if (command == "complete") { RequestCompletion(editor, true); return true; }
    if (editor.onCommand != null) { return editor.onCommand(command) == true; }
    return false;
};

# ---- 鍵盤 / Keyboard ----
var KeyEnter = 257; var KeyTab = 258; var KeyBackspace = 259; var KeyDelete = 261; var KeyRight = 262; var KeyLeft = 263;
var KeyDown = 264; var KeyUp = 265; var KeyPageUp = 266; var KeyPageDown = 267; var KeyHome = 268; var KeyEnd = 269;
var KeySpace = 32; var KeyPadEnter = 335;

var _moveVertical = function(editor, lines, extend) {
    var point = PointOf(editor, editor.cursor);
    if (editor.preferredX < 0) { editor.preferredX = point[0]; }
    var target = editor.cursor.line + lines;
    if (target < 0) { SetCursor(editor, buffers.Pos(0, 0), extend); return true; }
    if (target >= LineCount(editor)) { SetCursor(editor, buffers.End(editor.buffer), extend); return true; }
    var x = editor.preferredX;
    var p = PositionAt(editor, x, point[1] + lines * editor.lineHeight + editor.lineHeight / 2.0d);
    var keep = editor.preferredX;
    SetCursor(editor, buffers.Pos(target, p.character), extend);
    editor.preferredX = keep;
    return true;
};

# 按鍵的意義來自「互動」的編輯表：程式碼編輯器讀 e.codeEdit（VS Code 在各平台的預設：Alt＋上下移動行、Ctrl＋/ 註解…），
# 沒有時讀 e.edit；字與字的部分的邊界用「文字編輯」模組的規則，與其他 UI 的文字欄位一致。 / What a key means comes from
# Interaction's editing table: a code editor reads e.codeEdit (VS Code's defaults on each platform: Alt+Up/Down moves
# lines, Ctrl+/ comments, ...), else e.edit; word and word-part boundaries follow the TextEditing module's rules, as every
# UI library's text fields do.

# 行內依共用規則移動；在行首或行尾時移到相鄰的行。 / A move within the line by the shared rules; at a line's ends, to the
# neighbouring line.
var _lineMove = function(editor, direction, step) {
    var p = editor.cursor;
    var line = buffers.Line(editor.buffer, p.line);
    if (direction > 0) {
        if (p.character >= len(line)) {
            if (p.line + 1 < LineCount(editor)) { return buffers.Pos(p.line + 1, 0); }
            return p;
        }
        return buffers.Pos(p.line, step(line, p.character));
    }
    if (p.character == 0) {
        if (p.line > 0) { return buffers.Pos(p.line - 1, len(buffers.Line(editor.buffer, p.line - 1))); }
        return p;
    }
    return buffers.Pos(p.line, step(line, p.character));
};
var _wordLeft = function(line, at) { return TextEditing.WordLeft(line, at, _apple); };
var _wordRight = function(line, at) { return TextEditing.WordRight(line, at, _apple); };
var _partLeft = function(line, at) { return TextEditing.WordPartLeft(line, at); };
var _partRight = function(line, at) { return TextEditing.WordPartRight(line, at); };

# 選取（或游標）涵蓋的行：[第一行, 最後一行]；選取結束在行首時那一行不算。 / The lines the selection (or the caret)
# covers: [first, last]; a selection ending at a line's start leaves that line out.
var _selectedLines = function(editor) {
    var r = SelectionRange(editor);
    var last = r[1].line;
    if (HasSelection(editor) && r[1].character == 0 && last > r[0].line) { last = last - 1; }
    return [r[0].line, last];
};
var _linesText = function(editor, first, last) {
    var parts = [];
    for (var l = first; l <= last; l++) { Array.Append(parts, buffers.Line(editor.buffer, l)); }
    return String.Join(parts, _newline);
};
# 取代整行 [first, last] 為 text（一次復原），再放回游標與選取。 / Replaces lines [first, last] with text (one undo step),
# then puts the caret and the selection back.
var _replaceLines = function(editor, first, last, text, cursor, anchor) {
    var change = buffers.Edit(editor.buffer, buffers.Pos(first, 0), buffers.Pos(last, len(buffers.Line(editor.buffer, last))), text);
    editor.cursor = buffers.Clamp(editor.buffer, cursor);
    editor.anchor = null;
    if (anchor != null) { editor.anchor = buffers.Clamp(editor.buffer, anchor); }
    editor.preferredX = -1.0d;
    _changed(editor, [change]);
    return true;
};
var _shifted = function(p, lines) { if (p == null) { return null; } return buffers.Pos(p.line + lines, p.character); };

# Alt＋上下：把選到的行與上一行或下一行對調。 / Alt+Up/Down: swap the selected lines with the line above or below.
var MoveLines = function(editor, direction) {
    if (editor.readOnly) { return false; }
    var lines = _selectedLines(editor);
    var first = lines[0];
    var last = lines[1];
    if (direction < 0 && first == 0) { return true; }
    if (direction > 0 && last + 1 >= LineCount(editor)) { return true; }
    var block = _linesText(editor, first, last);
    if (direction < 0) {
        var above = buffers.Line(editor.buffer, first - 1);
        return _replaceLines(editor, first - 1, last, block + _newline + above, _shifted(editor.cursor, -1), _shifted(editor.anchor, -1));
    }
    var below = buffers.Line(editor.buffer, last + 1);
    return _replaceLines(editor, first, last + 1, below + _newline + block, _shifted(editor.cursor, 1), _shifted(editor.anchor, 1));
};
# Shift＋Alt＋上下：把選到的行複製到上方或下方（游標跟著複本）。 / Shift+Alt+Up/Down: copy the selected lines above or
# below (the caret goes with the copy below).
var CopyLines = function(editor, direction) {
    if (editor.readOnly) { return false; }
    var lines = _selectedLines(editor);
    var block = _linesText(editor, lines[0], lines[1]);
    var count = lines[1] - lines[0] + 1;
    var moved = if (direction > 0) { count; } else { 0; };
    return _replaceLines(editor, lines[0], lines[1], block + _newline + block, _shifted(editor.cursor, moved), _shifted(editor.anchor, moved));
};
# Ctrl＋Shift＋K：刪除選到的行。 / Ctrl+Shift+K: delete the selected lines.
var DeleteLines = function(editor) {
    if (editor.readOnly) { return false; }
    var lines = _selectedLines(editor);
    var column = editor.cursor.character;
    var start = buffers.Pos(lines[0], 0);
    var end = buffers.Pos(lines[1] + 1, 0);
    if (lines[1] + 1 >= LineCount(editor)) {
        end = buffers.Pos(lines[1], len(buffers.Line(editor.buffer, lines[1])));
        if (lines[0] > 0) { start = buffers.Pos(lines[0] - 1, len(buffers.Line(editor.buffer, lines[0] - 1))); }
    }
    DeleteRange(editor, start, end);
    var line = lines[0];
    if (line >= LineCount(editor)) { line = LineCount(editor) - 1; }
    SetCursor(editor, buffers.Clamp(editor.buffer, buffers.Pos(line, column)), false);
    return true;
};
# Ctrl＋Enter／Ctrl＋Shift＋Enter：在下方／上方開新行（保持縮排），不打斷目前這行。 / Ctrl+Enter, Ctrl+Shift+Enter: open a
# line below or above (keeping the indentation) without breaking the current one.
var InsertLine = function(editor, above) {
    if (editor.readOnly) { return false; }
    var l = editor.cursor.line;
    var indent = buffers.Indentation(editor.buffer, l);
    if (above) {
        SetCursor(editor, buffers.Pos(l, 0), false);
        Insert(editor, indent + _newline);
        SetCursor(editor, buffers.Pos(l, len(indent)), false);
        return true;
    }
    SetCursor(editor, buffers.Pos(l, len(buffers.Line(editor.buffer, l))), false);
    return NewLine(editor);
};
# Ctrl＋/：切換行註解（星泉用 #）。 / Ctrl+/: toggle line comments (AquariusLang's #).
var ToggleComment = function(editor) {
    if (editor.readOnly) { return false; }
    var lines = _selectedLines(editor);
    var commented = true;
    var indent = -1;
    for (var l = lines[0]; l <= lines[1]; l++) {
        var text = buffers.Line(editor.buffer, l);
        if (String.Trim(text) == "") { continue; }
        var lead = len(buffers.Indentation(editor.buffer, l));
        if (indent < 0 || lead < indent) { indent = lead; }
        if (!String.StartsWith(String.Slice(text, lead, len(text)), "#")) { commented = false; }
    }
    if (indent < 0) { return true; }
    var out = [];
    var shift = 0;
    for (var l = lines[0]; l <= lines[1]; l++) {
        var text = buffers.Line(editor.buffer, l);
        if (String.Trim(text) == "") { Array.Append(out, text); continue; }
        if (commented) {
            var lead = len(buffers.Indentation(editor.buffer, l));
            var cut = if (String.StartsWith(String.Slice(text, lead, len(text)), "# ")) { 2; } else { 1; };
            Array.Append(out, String.Slice(text, 0, lead) + String.Slice(text, lead + cut, len(text)));
            if (l == editor.cursor.line) { shift = -cut; }
        } else {
            Array.Append(out, String.Slice(text, 0, indent) + "# " + String.Slice(text, indent, len(text)));
            if (l == editor.cursor.line) { shift = 2; }
        }
    }
    var cursor = buffers.Pos(editor.cursor.line, editor.cursor.character + shift);
    if (cursor.character < 0) { cursor = buffers.Pos(cursor.line, 0); }
    var anchor = null;
    if (HasSelection(editor)) { anchor = editor.anchor; }
    return _replaceLines(editor, lines[0], lines[1], String.Join(out, _newline), cursor, anchor);
};
# Ctrl＋] 與 Ctrl＋[：整行縮排與取消縮排（不論游標在哪）。 / Ctrl+] and Ctrl+[: indent and outdent whole lines wherever the
# caret is.
var IndentLines = function(editor, outdent) {
    if (editor.readOnly) { return false; }
    var lines = _selectedLines(editor);
    var out = [];
    var shift = 0;
    for (var l = lines[0]; l <= lines[1]; l++) {
        var text = buffers.Line(editor.buffer, l);
        var delta = 0;
        if (outdent) {
            var lead = len(buffers.Indentation(editor.buffer, l));
            delta = -lead;
            if (lead > len(editor.tabText)) { delta = -len(editor.tabText); }
            Array.Append(out, String.Slice(text, -delta, len(text)));
        } else {
            delta = len(editor.tabText);
            Array.Append(out, editor.tabText + text);
        }
        if (l == editor.cursor.line) { shift = delta; }
    }
    var cursor = buffers.Pos(editor.cursor.line, editor.cursor.character + shift);
    if (cursor.character < 0) { cursor = buffers.Pos(cursor.line, 0); }
    var anchor = null;
    if (HasSelection(editor)) { anchor = editor.anchor; }
    return _replaceLines(editor, lines[0], lines[1], String.Join(out, _newline), cursor, anchor);
};
# Ctrl＋L：選取整行（再按一次加選下一行）。 / Ctrl+L: select the whole line (again: the next line too).
var SelectLines = function(editor) {
    var lines = _selectedLines(editor);
    var last = lines[1];
    if (HasSelection(editor) && editor.cursor.character == 0 && editor.cursor.line == last + 1) { last = last + 1; }
    var start = buffers.Pos(lines[0], 0);
    var end = buffers.Pos(last + 1, 0);
    if (last + 1 >= LineCount(editor)) { end = buffers.Pos(last, len(buffers.Line(editor.buffer, last))); }
    Select(editor, start, end);
    return true;
};
# Ctrl＋Shift＋\：跳到對應的括號。 / Ctrl+Shift+\: jump to the matching bracket.
var _opens = "([{";
var _closes = ")]}";
var JumpToBracket = function(editor) {
    var p = editor.cursor;
    var line = buffers.Line(editor.buffer, p.line);
    var at = -1;
    if (p.character < len(line) && String.Find(_opens + _closes, String.Slice(line, p.character, p.character + 1)) >= 0) { at = p.character; }
    elif (p.character > 0 && String.Find(_opens + _closes, String.Slice(line, p.character - 1, p.character)) >= 0) { at = p.character - 1; }
    if (at < 0) { return true; }
    var c = String.Slice(line, at, at + 1);
    var open = String.Find(_opens, c);
    var forward = open >= 0;
    var mate = if (forward) { String.Slice(_closes, open, open + 1); } else { String.Slice(_opens, String.Find(_closes, c), String.Find(_closes, c) + 1); };
    var depth = 0;
    var l = p.line;
    var i = at;
    for (; l >= 0 && l < LineCount(editor);) {
        var text = buffers.Line(editor.buffer, l);
        for (; i >= 0 && i < len(text);) {
            var ch = String.Slice(text, i, i + 1);
            if (ch == c) { depth++; }
            elif (ch == mate) {
                depth = depth - 1;
                if (depth == 0) {
                    var target = if (forward) { i + 1; } else { i; };
                    SetCursor(editor, buffers.Pos(l, target), false);
                    return true;
                }
            }
            i = if (forward) { i + 1; } else { i - 1; };
        }
        l = if (forward) { l + 1; } else { l - 1; };
        if (l >= 0 && l < LineCount(editor)) { i = if (forward) { 0; } else { len(buffers.Line(editor.buffer, l)) - 1; }; }
    }
    return true;
};
# Apple 的 Ctrl＋T：對調游標兩側的字元。 / Apple's Ctrl+T: swap the characters around the caret.
var Transpose = function(editor) {
    if (editor.readOnly || HasSelection(editor)) { return true; }
    var p = editor.cursor;
    var line = buffers.Line(editor.buffer, p.line);
    var at = p.character;
    if (at >= len(line)) { at = len(line) - 1; }
    if (at <= 0) { return true; }
    var swapped = String.Slice(line, at, at + 1) + String.Slice(line, at - 1, at);
    var change = buffers.Edit(editor.buffer, buffers.Pos(p.line, at - 1), buffers.Pos(p.line, at + 1), swapped);
    editor.cursor = change.newEnd;
    _changed(editor, [change]);
    return true;
};

var HandleKey = function(editor, e) {
    if (e.action == "release") { return false; }
    var key = e.key;
    if (key == KeyPadEnter) { key = KeyEnter; }   # 數字鍵盤的 Enter。 / The keypad's Enter.
    var shift = e.shift == true;
    var edit = e.codeEdit;
    if (edit == null) { edit = e.edit; }
    if (editor.completion != null) {
        var items = editor.completion["items"];
        if (key == KeyDown) { editor.completion["selected"] = (editor.completion["selected"] + 1) % len(items); return true; }
        if (key == KeyUp) { editor.completion["selected"] = (editor.completion["selected"] + len(items) - 1) % len(items); return true; }
        if (key == KeyEnter || key == KeyTab) { AcceptCompletion(editor); return true; }
    }
    if (edit == null) {
        if (key == KeyTab && e.primary != true) { if (editor.readOnly) { return false; } Indent(editor, shift); return true; }
        if (key == KeySpace && e.primary == true) { RequestCompletion(editor, true); return true; }
        # 文字來自 "text" 事件（視窗的文字輸入與輸入法），不是按鍵名稱。 / Text comes from "text" events (the window's
        # text input and input methods), not from key names.
        return false;
    }
    # 移動（Shift 延伸選取）。 / Moves (Shift extends the selection).
    if (edit == "left" || edit == "right") {
        editor.preferredX = -1.0d;
        editor.completion = null;
        if (HasSelection(editor) && !shift) {
            var range = SelectionRange(editor);
            if (edit == "left") { SetCursor(editor, range[0], false); } else { SetCursor(editor, range[1], false); }
            return true;
        }
        var p = editor.cursor;
        var line = buffers.Line(editor.buffer, p.line);
        if (edit == "left") {
            if (p.character > 0) { SetCursor(editor, buffers.Pos(p.line, TextEditing.Previous(line, p.character)), shift); }
            elif (p.line > 0) { SetCursor(editor, buffers.Pos(p.line - 1, len(buffers.Line(editor.buffer, p.line - 1))), shift); }
        } else {
            if (p.character < len(line)) { SetCursor(editor, buffers.Pos(p.line, TextEditing.Next(line, p.character)), shift); }
            elif (p.line + 1 < LineCount(editor)) { SetCursor(editor, buffers.Pos(p.line + 1, 0), shift); }
        }
        return true;
    }
    if (edit == "wordLeft") { editor.preferredX = -1.0d; SetCursor(editor, _lineMove(editor, -1, _wordLeft), shift); return true; }
    if (edit == "wordRight") { editor.preferredX = -1.0d; SetCursor(editor, _lineMove(editor, 1, _wordRight), shift); return true; }
    if (edit == "wordPartLeft") { editor.preferredX = -1.0d; SetCursor(editor, _lineMove(editor, -1, _partLeft), shift); return true; }
    if (edit == "wordPartRight") { editor.preferredX = -1.0d; SetCursor(editor, _lineMove(editor, 1, _partRight), shift); return true; }
    if (edit == "up") { editor.completion = null; return _moveVertical(editor, -1, shift); }
    if (edit == "down") { editor.completion = null; return _moveVertical(editor, 1, shift); }
    var page = int(editor.view.height / editor.lineHeight) - 1;
    if (page < 1) { page = 1; }
    if (edit == "pageUp") { ScrollView.ScrollBy(editor.view, 0, -page * editor.lineHeight); return _moveVertical(editor, -page, shift); }
    if (edit == "pageDown") { ScrollView.ScrollBy(editor.view, 0, page * editor.lineHeight); return _moveVertical(editor, page, shift); }
    if (edit == "scrollLineUp") { ScrollView.ScrollBy(editor.view, 0, -editor.lineHeight); return true; }
    if (edit == "scrollLineDown") { ScrollView.ScrollBy(editor.view, 0, editor.lineHeight); return true; }
    if (edit == "documentStart") { editor.preferredX = -1.0d; SetCursor(editor, buffers.Pos(0, 0), shift); return true; }
    if (edit == "documentEnd") { editor.preferredX = -1.0d; SetCursor(editor, buffers.End(editor.buffer), shift); return true; }
    if (edit == "paragraphStart" || edit == "paragraphEnd") {
        # 空行之間為一段。 / Paragraphs lie between blank lines.
        var step = if (edit == "paragraphStart") { -1; } else { 1; };
        var l = editor.cursor.line + step;
        for (; l > 0 && l < LineCount(editor) - 1 && String.Trim(buffers.Line(editor.buffer, l)) != "";) { l = l + step; }
        if (l < 0) { l = 0; }
        if (l >= LineCount(editor)) { l = LineCount(editor) - 1; }
        SetCursor(editor, buffers.Pos(l, 0), shift);
        return true;
    }
    if (edit == "lineStart") {
        editor.preferredX = -1.0d;
        # 先到第一個非空白字元，再到行首。 / First to the first non-space character, then to the line start.
        var indent = len(buffers.Indentation(editor.buffer, editor.cursor.line));
        var column = indent;
        if (editor.cursor.character == indent) { column = 0; }
        SetCursor(editor, buffers.Pos(editor.cursor.line, column), shift);
        return true;
    }
    if (edit == "lineEnd") {
        editor.preferredX = -1.0d;
        SetCursor(editor, buffers.Pos(editor.cursor.line, len(buffers.Line(editor.buffer, editor.cursor.line))), shift);
        return true;
    }
    if (edit == "selectAll") { SelectAll(editor); return true; }
    if (edit == "selectLine") { return SelectLines(editor); }
    if (edit == "jumpToBracket") { return JumpToBracket(editor); }
    # 剪貼簿與復原（Interaction 也送同名命令，見 HandleEvent）。 / Clipboard and history (Interaction also sends commands of
    # the same names; see HandleEvent).
    if (edit == "copy" || edit == "cut" || edit == "paste" || edit == "undo" || edit == "redo") { return RunCommand(editor, edit); }
    if (edit == "toggleOverwrite") { editor.overwrite = !editor.overwrite; return true; }
    if (editor.readOnly) { return false; }
    var lineStart = buffers.Pos(editor.cursor.line, 0);
    var lineEnd = buffers.Pos(editor.cursor.line, len(buffers.Line(editor.buffer, editor.cursor.line)));
    if (edit == "deleteBackward") { Backspace(editor); _refreshCompletion(editor); return true; }
    if (edit == "deleteForward") { DeleteForward(editor); return true; }
    if (HasSelection(editor) && (edit == "deleteWordBackward" || edit == "deleteWordPartBackward" || edit == "deleteToLineStart")) { Backspace(editor); _refreshCompletion(editor); return true; }
    if (HasSelection(editor) && (edit == "deleteWordForward" || edit == "deleteWordPartForward" || edit == "deleteToLineEnd")) { DeleteForward(editor); return true; }
    if (edit == "deleteWordBackward") { DeleteRange(editor, _lineMove(editor, -1, _wordLeft), editor.cursor); _refreshCompletion(editor); return true; }
    if (edit == "deleteWordForward") { DeleteRange(editor, editor.cursor, _lineMove(editor, 1, _wordRight)); return true; }
    if (edit == "deleteWordPartBackward") { DeleteRange(editor, _lineMove(editor, -1, _partLeft), editor.cursor); _refreshCompletion(editor); return true; }
    if (edit == "deleteWordPartForward") { DeleteRange(editor, editor.cursor, _lineMove(editor, 1, _partRight)); return true; }
    if (edit == "deleteToLineStart") { DeleteRange(editor, lineStart, editor.cursor); return true; }
    if (edit == "deleteToLineEnd") {
        # Ctrl＋K 剪下的文字進入編輯器的刪除緩衝區，Ctrl＋Y 貼回（Apple）。 / What Ctrl+K cuts goes to the editor's kill
        # buffer, which Ctrl+Y yanks back (Apple).
        var end = lineEnd;
        if (buffers.Compare(editor.cursor, lineEnd) == 0 && editor.cursor.line + 1 < LineCount(editor)) { end = buffers.Pos(editor.cursor.line + 1, 0); }
        editor.kill = buffers.Slice(editor.buffer, editor.cursor, end);
        DeleteRange(editor, editor.cursor, end);
        return true;
    }
    if (edit == "yank") { if (editor.kill != "") { Insert(editor, editor.kill); } return true; }
    if (edit == "transpose") { return Transpose(editor); }
    if (edit == "openLine") { var stay = editor.cursor; Insert(editor, _newline); SetCursor(editor, stay, false); return true; }
    if (edit == "newline") { NewLine(editor); return true; }
    if (edit == "insertLineBelow") { return InsertLine(editor, false); }
    if (edit == "insertLineAbove") { return InsertLine(editor, true); }
    if (edit == "moveLineUp") { return MoveLines(editor, -1); }
    if (edit == "moveLineDown") { return MoveLines(editor, 1); }
    if (edit == "copyLineUp") { return CopyLines(editor, -1); }
    if (edit == "copyLineDown") { return CopyLines(editor, 1); }
    if (edit == "deleteLine") { return DeleteLines(editor); }
    if (edit == "toggleComment") { return ToggleComment(editor); }
    if (edit == "indent") { return IndentLines(editor, false); }
    if (edit == "outdent") { return IndentLines(editor, true); }
    if (key == KeyTab && e.primary != true) { Indent(editor, shift); return true; }
    if (key == KeySpace && e.primary == true) { RequestCompletion(editor, true); return true; }
    return false;
};

# ---- 指標 / Pointer ----
# 「互動」事件：點擊（次數）、拖曳、捲動、右鍵選單、鍵盤命令。回傳 真 表示已處理。
# An Interaction event: clicks with counts, drags, scrolling, context menus, keyboard commands; true when handled.
var _keyedCommands = ["copy", "cut", "paste", "undo", "redo", "selectAll", "delete"];
var HandleEvent = function(editor, e) {
    if (ContextMenu.Handle(editor.menu, e)) { return true; }
    var t = e.type;
    if (t == "command") {
        # 鍵盤送來的編輯命令已由按鍵的編輯動作做過（同一個按鍵也送 "key" 事件）。 / Editing commands from the keyboard
        # were already done by the key's editing action (the same key also sends a "key" event).
        if (e.source == "keyboard" && editor.focused && Array.Contains(_keyedCommands, e.command)) { return true; }
        return RunCommand(editor, e.command);
    }
    if (t == "key") {
        if (!editor.focused) { return false; }
        # 組字中的按鍵屬於輸入法。 / Keys while composing belong to the input method.
        if (editor.composition != "") { return true; }
        return HandleKey(editor, e);
    }
    if (t == "text") {
        if (!editor.focused || e.text == null) { return false; }
        if (String.Code(e.text, 0) < 32 || String.Code(e.text, 0) == 127) { return false; }
        Type(editor, e.text);
        return true;
    }
    # 輸入法組字（注音、拼音、假名…）：未確定的文字畫在游標處並加底線，確定後以 "text" 事件送來。
    # Input-method composition: the text not yet committed shows underlined at the caret; it arrives as "text" when committed.
    if (t == "composition") {
        if (!editor.focused) { return false; }
        var composed = e.text;
        if (composed == null || e.phase == "end") { composed = ""; }
        editor.composition = composed;
        editor.compositionCursor = len(composed);
        if (e.cursor != null && e.cursor >= 0 && e.cursor <= len(composed)) { editor.compositionCursor = e.cursor; }
        if (composed != "") { editor.completion = null; }
        _restartBlink(editor);
        return true;
    }
    if (t == "move") {
        editor.pointerX = e.x; editor.pointerY = e.y; editor.pointerTime = currentTime(); editor.hoverAsked = false;
        if (editor.hover != null && !_near(editor, e.x, e.y)) { editor.hover = null; }
        ScrollView.Handle(editor.view, e);
        return false;
    }
    if (ScrollView.Handle(editor.view, e)) { return true; }
    if (e.x != null && !ScrollView.Contains(editor.view, e.x, e.y)) {
        if (t == "press") { editor.focused = false; editor.completion = null; editor.composition = ""; }
        return false;
    }
    if (t == "press" && e.button == 0) {
        editor.focused = true;
        editor.completion = null;
        editor.hover = null;
        var p = PositionAt(editor, e.x, e.y);
        SetCursor(editor, p, e.shift == true);
        editor.dragging = true;
        return true;
    }
    if (t == "click" && e.button == 0) {
        var p = PositionAt(editor, e.x, e.y);
        if (e.count == 2) { var w = buffers.WordAt(editor.buffer, p); Select(editor, buffers.Pos(p.line, w[0]), buffers.Pos(p.line, w[1])); }
        else if (e.count >= 3) {
            var end = buffers.Pos(p.line + 1, 0);
            if (p.line + 1 >= LineCount(editor)) { end = buffers.Pos(p.line, len(buffers.Line(editor.buffer, p.line))); }
            Select(editor, buffers.Pos(p.line, 0), end);
        }
        return true;
    }
    if ((t == "dragStart" || t == "drag") && editor.dragging) {
        SetCursor(editor, PositionAt(editor, e.x, e.y), true);
        return true;
    }
    if (t == "dragEnd" || t == "release") { editor.dragging = false; return t == "dragEnd"; }
    if (t == "contextMenu") {
        editor.focused = true;
        ContextMenu.Clear(editor.menu);
        ContextMenu.Add(editor.menu, "cut", "剪下 Cut", HasSelection(editor) && !editor.readOnly);
        ContextMenu.Add(editor.menu, "copy", "複製 Copy", HasSelection(editor));
        ContextMenu.Add(editor.menu, "paste", "貼上 Paste", !editor.readOnly);
        ContextMenu.AddSeparator(editor.menu);
        ContextMenu.Add(editor.menu, "selectAll", "全選 Select All", true);
        ContextMenu.Add(editor.menu, "complete", "建議 Suggest", !editor.readOnly);
        ContextMenu.Open(editor.menu, e.x, e.y, editor.view.left + editor.view.width, editor.view.top + editor.view.height, e.time);
        return true;
    }
    return false;
};
# 「互動」工作階段：把事件交給編輯器（最後註冊的先處理）。 / Feed an Interaction session's events to the editor.
var Attach = function(editor, session) {
    editor.session = session;
    return session.On("*", function(e) { return HandleEvent(editor, e); });
};

# 游標形狀：文字上是文字游標，行號欄、捲軸與浮動視窗上是箭頭。 / Cursor shapes: the text cursor over the text, the
# arrow over the line numbers, the scrollbars and popups.
var _cursorAreas = function(editor) {
    var view = editor.view;
    var gutter = GutterWidth(editor);
    var areas = [["text", view.left + gutter, view.top, view.width - gutter, view.height, "text"]];
    var bars = [ScrollView.VerticalBar(view), ScrollView.HorizontalBar(view)];
    for (var i = 0; i < 2; i++) { if (bars[i].visible) { Array.Append(areas, ["bar" + String.From(i), bars[i].x, bars[i].y, bars[i].width, bars[i].height, "arrow"]); } }
    if (editor.completion != null) {
        var box = CompletionBox(editor);
        Array.Append(areas, ["completion", box[0], box[1], box[2], box[3], "arrow"]);
    }
    if (editor.menu.open) { Array.Append(areas, ["menu", editor.menu.x, editor.menu.y, editor.menu.width, ContextMenu.Height(editor.menu), "arrow"]); }
    var parts = [];
    for (var i = 0; i < len(areas); i++) { Array.Append(parts, String.Join(Array.Map(areas[i], function(v) { return String.From(v); }), ",")); }
    var key = String.Join(parts, ";");
    if (key == editor.areaKey) { return false; }
    var names = ["text", "bar0", "bar1", "completion", "menu"];
    for (var i = 0; i < len(names); i++) { editor.session.RemoveCursorArea(editor.areaName + "." + names[i]); }
    for (var i = 0; i < len(areas); i++) {
        var a = areas[i];
        editor.session.CursorArea(editor.areaName + "." + a[0], a[1], a[2], a[3], a[4], a[5]);
    }
    editor.areaKey = key;
    return true;
};

var _near = function(editor, x, y) {
    if (editor.hover == null) { return false; }
    return y >= editor.hover["y"] - editor.lineHeight && y <= editor.hover["y"] + editor.lineHeight * 2.0d;
};

# ---- 每個影格 / Every frame ----
# 推進捲動動量，並在指標停留時向語言伺服器要說明。 / Run scroll momentum and ask for hover after the pointer rests.
var Update = function(editor, seconds) {
    ScrollView.Update(editor.view, seconds);
    # 有焦點時接收文字輸入，輸入法視窗跟著游標。 / Take text input while focused; input-method windows follow the caret.
    if (editor.session != null) {
        if (editor.focused != editor.textInput) { editor.textInput = editor.focused; editor.session.TextInput(editor.focused); }
        if (editor.focused) {
            var point = PointOf(editor, editor.cursor);
            var rect = String.From(int(point[0])) + "," + String.From(int(point[1]));
            if (rect != editor.textRect) { editor.textRect = rect; editor.session.TextRect(int(point[0]), int(point[1]), 2, int(editor.lineHeight)); }
        }
        _cursorAreas(editor);
    }
    if (editor.client != null && !editor.hoverAsked && editor.pointerX >= 0 && currentTime() - editor.pointerTime > 600.0d
        && ScrollView.Contains(editor.view, editor.pointerX, editor.pointerY)) {
        editor.hoverAsked = true;
        var p = PositionAt(editor, editor.pointerX, editor.pointerY);
        var line = buffers.Line(editor.buffer, p.line);
        if (p.character < len(line)) { _member(editor.client, "hover")(p); }
    }
    return true;
};

# ---- 語言伺服器的結果 / Language server results ----
var SetDiagnostics = function(editor, diagnostics) { editor.diagnostics = diagnostics; };
var SetHover = function(editor, p, text) {
    if (text == null || text == "") { editor.hover = null; return false; }
    var point = PointOf(editor, p);
    editor.hover = {"text": text, "x": point[0], "y": point[1] + editor.lineHeight, "line": p.line, "character": p.character};
    return true;
};
var SetSignature = function(editor, signature) { editor.signature = signature; };

var _isTrigger = function(text) { return text == "."; };
var _afterTyping = function(editor, text) {
    if (editor.client == null) { return false; }
    var c = String.Code(text, 0);
    var word = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128;
    if (_isTrigger(text) || word) { _member(editor.client, "complete")(editor.cursor, text); }
    else { editor.completion = null; }
    if (text == "(" || text == ",") { _member(editor.client, "signature")(editor.cursor); }
    if (text == ")") { editor.signature = null; }
    return true;
};
var _refreshCompletion = function(editor) {
    if (editor.completion != null && editor.client != null) { _member(editor.client, "complete")(editor.cursor, ""); }
};
var RequestCompletion = function(editor, explicit) {
    if (editor.client != null) { _member(editor.client, "complete")(editor.cursor, ""); }
};

# 語言伺服器的自動完成項目（依字首篩選、排序）。 / Completion items from the server, filtered by prefix and sorted.
var SetCompletion = function(editor, p, items) {
    if (buffers.Compare(p, editor.cursor) != 0) { return false; }
    var prefix = buffers.PrefixAt(editor.buffer, editor.cursor);
    var lower = String.Lower(prefix);
    var kept = Array.Filter(items, function(item) {
        var filter = item["filterText"];
        if (filter == null) { filter = item["label"]; }
        return prefix == "" || String.StartsWith(String.Lower(filter), lower);
    });
    # 依 sortText（沒有則 label）排序，同鍵保持原順序。 / Sort by sortText (else label), stable.
    var keys = [];
    for (var i = 0; i < len(kept); i++) {
        var key = kept[i]["sortText"];
        if (key == null) { key = kept[i]["label"]; }
        Array.Append(keys, key + String.FromCode(1) + String.From(100000 + i));
    }
    Array.Sort(keys);
    var sorted = [];
    for (var i = 0; i < len(keys); i++) {
        var parts = String.Split(keys[i], String.FromCode(1));
        Array.Append(sorted, kept[String.ParseInt(parts[len(parts) - 1]) - 100000]);
    }
    kept = sorted;
    if (len(kept) == 0) { editor.completion = null; return false; }
    if (len(kept) > 200) { kept = Array.Slice(kept, 0, 200); }
    editor.completion = {"items": kept, "selected": 0, "line": p.line, "start": p.character - len(prefix)};
    return true;
};

# 套用選定的項目：取代字首，程式片段的 ${1:x}/$0 變成游標位置。 / Apply the selected item: it replaces the prefix;
# a snippet's ${1:x} / $0 stops become the cursor position.
var AcceptCompletion = function(editor) {
    if (editor.completion == null) { return false; }
    var item = editor.completion["items"][editor.completion["selected"]];
    var text = item["insertText"];
    if (text == null) { text = item["label"]; }
    var snippet = item["insertTextFormat"] == 2;
    editor.completion = null;
    var start = buffers.Pos(editor.cursor.line, buffers.WordAt(editor.buffer, editor.cursor)[0]);
    if (start.character > editor.cursor.character) { start = editor.cursor; }
    var stop = -1;
    if (snippet) {
        var plain = _expandSnippet(text);
        text = plain[0];
        stop = plain[1];
    }
    editor.anchor = start;
    Insert(editor, text);
    if (stop >= 0) { SetCursor(editor, buffers.PositionOf(editor.buffer, buffers.OffsetOf(editor.buffer, start) + stop), false); }
    if (String.EndsWith(text, "()") || (snippet && stop >= 1 && String.Slice(text, stop - 1, stop) == "(")) { _afterTyping(editor, "("); }
    return true;
};

# "${1:名稱}" → "名稱"，"$1"、"$0" 拿掉；回傳 [文字, 第一個停駐點位置]。 / Expand placeholders; returns [text, first stop].
var _expandSnippet = function(text) {
    var parts = [];
    var stop = -1;
    var i = 0;
    var length = 0;
    for (; i < len(text);) {
        var c = String.Code(text, i);
        if (c == 36 && i + 1 < len(text)) {
            var d = String.Code(text, i + 1);
            if (d == 123) {
                var close = String.Find(String.Slice(text, i, len(text)), "}");
                var inner = String.Slice(text, i + 2, i + close);
                var colon = String.Find(inner, ":");
                var value = "";
                if (colon >= 0) { value = String.Slice(inner, colon + 1, len(inner)); }
                if (stop < 0) { stop = length; }
                Array.Append(parts, value);
                length += len(value);
                i = i + close + 1;
                continue;
            }
            if (d >= 48 && d <= 57) {
                if (stop < 0 || d == 48 && stop < 0) { stop = length; }
                i += 2;
                continue;
            }
        }
        Array.Append(parts, String.Slice(text, i, i + 1));
        length++;
        i++;
    }
    return [String.Join(parts, ""), stop];
};

# ---- 繪製模型 / Render model ----
var _tokensFor = function(editor) {
    if (editor.tokens == null || editor.tokensVersion != editor.buffer.version) {
        editor.tokens = highlight.Tokenize(editor.buffer.lines);
        editor.tokensVersion = editor.buffer.version;
    }
    return editor.tokens;
};

# 浮動視窗的大小（每個字約 7.5 單位寬）。 / A popup's size (about 7.5 units per character).
var PopupSize = function(rows, lineHeight) {
    var width = 120.0d;
    for (var i = 0; i < len(rows); i++) { var w = len(rows[i]) * 7.5d + 16.0d; if (w > width) { width = w; } }
    if (width > 520.0d) { width = 520.0d; }
    return [width, len(rows) * (lineHeight + 2.0d) + 6.0d];
};
# 自動完成清單可見的列（最多 8 列，捲到選定項）與第一列的索引。 / The completion list's visible rows (up to 8,
# scrolled to the selected item) and the index of the first.
var CompletionRows = function(completion) {
    var items = completion["items"];
    var first = 0;
    if (completion["selected"] >= 8) { first = completion["selected"] - 7; }
    var rows = [];
    for (var i = first; i < len(items) && i < first + 8; i++) {
        var detail = items[i]["detail"];
        var row = items[i]["label"];
        if (detail != null && detail != "" && detail != row) {
            if (len(detail) > 48) { detail = String.Slice(detail, 0, 48) + "…"; }
            row = row + "    " + detail;
        }
        Array.Append(rows, row);
    }
    return [rows, first];
};
# 自動完成清單的 [x, y, 寬, 高]。 / The completion list's [x, y, width, height].
var CompletionBox = function(editor) {
    var start = PointOf(editor, buffers.Pos(editor.completion["line"], editor.completion["start"]));
    var size = PopupSize(CompletionRows(editor.completion)[0], editor.lineHeight);
    return [start[0], start[1] + editor.lineHeight, size[0], size[1]];
};

var CaretVisible = function(editor) {
    if (!editor.focused) { return false; }
    if (editor.blinkTime <= 0) { return true; }
    var phase = (currentTime() - editor.blinkStart) / editor.blinkTime;
    return int(phase) % 2 == 0;
};

# 要畫的一切（視窗座標）。lines：可見行的 {number, y, runs: [{x, text, kind}]}；caret；selections；diagnostics；
# completion；hover；signature；menu；scrollbars；gutterWidth；theme。
# Everything to draw, in window coordinates.
var RenderModel = function(editor) {
    var view = editor.view;
    var gutter = GutterWidth(editor);
    var first = int(view.y / editor.lineHeight);
    var last = int((view.y + view.height) / editor.lineHeight) + 1;
    if (last > LineCount(editor)) { last = LineCount(editor); }
    var tokens = _tokensFor(editor);
    var lines = [];
    var textLeft = view.left + gutter + editor.padding - view.x;
    for (var l = first; l < last; l++) {
        var text = buffers.Line(editor.buffer, l);
        var y = view.top + l * editor.lineHeight - view.y;
        var pieces = [];
        var at = 0;
        var lineTokens = tokens[l];
        for (var t = 0; t < len(lineTokens); t++) {
            var token = lineTokens[t];
            if (token[0] > at) { Array.Append(pieces, [at, token[0], "text"]); }
            Array.Append(pieces, [token[0], token[1], token[2]]);
            at = token[1];
        }
        if (at < len(text)) { Array.Append(pieces, [at, len(text), "text"]); }
        # 組字中的文字插在游標處，後面的文字往右移。 / Composed text goes in at the caret, pushing the rest right.
        var composing = editor.composition != "" && l == editor.cursor.line;
        var split = editor.cursor.character;
        var shift = 0.0d;
        if (composing) { shift = TextWidth(editor, editor.composition); }
        var runs = [];
        for (var k = 0; k < len(pieces); k++) {
            var piece = pieces[k];
            var parts = [piece];
            if (composing && piece[0] < split && piece[1] > split) { parts = [[piece[0], split, piece[2]], [split, piece[1], piece[2]]]; }
            for (var q = 0; q < len(parts); q++) {
                var part = parts[q];
                var x = textLeft + TextWidth(editor, String.Slice(text, 0, part[0]));
                if (composing && part[0] >= split) { x += shift; }
                Array.Append(runs, {"x": x, "text": String.Slice(text, part[0], part[1]), "kind": part[2]});
            }
        }
        if (composing) { Array.Append(runs, {"x": textLeft + TextWidth(editor, String.Slice(text, 0, split)), "text": editor.composition, "kind": "composition"}); }
        Array.Append(lines, {"number": l + 1, "y": y, "runs": runs, "current": l == editor.cursor.line});
    }
    var selections = [];
    if (HasSelection(editor)) {
        var range = SelectionRange(editor);
        for (var l = range[0].line; l <= range[1].line; l++) {
            if (l < first || l >= last) { continue; }
            var text = buffers.Line(editor.buffer, l);
            var from = 0;
            var to = len(text);
            if (l == range[0].line) { from = range[0].character; }
            if (l == range[1].line) { to = range[1].character; }
            var x0 = textLeft + TextWidth(editor, String.Slice(text, 0, from));
            var x1 = textLeft + TextWidth(editor, String.Slice(text, 0, to));
            if (l != range[1].line) { x1 += editor.charWidth; }
            Array.Append(selections, {"x": x0, "y": view.top + l * editor.lineHeight - view.y, "width": x1 - x0, "height": editor.lineHeight});
        }
    }
    var marks = [];
    for (var d = 0; d < len(editor.diagnostics); d++) {
        var diagnostic = editor.diagnostics[d];
        var r = diagnostic["range"];
        var l = r["start"]["line"];
        if (l < first || l >= last || l >= LineCount(editor)) { continue; }
        var text = buffers.Line(editor.buffer, l);
        var from = r["start"]["character"];
        var to = r["end"]["character"];
        if (r["end"]["line"] != l) { to = len(text); }
        if (to <= from) { to = from + 1; }
        var x0 = textLeft + TextWidth(editor, String.Slice(text, 0, from));
        var x1 = textLeft + TextWidth(editor, String.Slice(text, 0, to));
        if (x1 - x0 < editor.charWidth) { x1 = x0 + editor.charWidth; }
        var severity = "error";
        if (diagnostic["severity"] == 2) { severity = "warning"; }
        if (diagnostic["severity"] >= 3) { severity = "information"; }
        Array.Append(marks, {"x": x0, "y": view.top + (l + 1) * editor.lineHeight - view.y - 2.0d, "width": x1 - x0,
            "severity": severity, "message": diagnostic["message"], "line": l});
    }
    var caretPoint = PointOf(editor, editor.cursor);
    var composition = null;
    if (editor.composition != "") {
        composition = {"x": caretPoint[0], "y": caretPoint[1], "width": TextWidth(editor, editor.composition), "height": editor.lineHeight,
            "text": editor.composition, "cursor": editor.compositionCursor};
        caretPoint = [caretPoint[0] + TextWidth(editor, String.Slice(editor.composition, 0, editor.compositionCursor)), caretPoint[1]];
    }
    var completion = null;
    if (editor.completion != null) {
        var start = PointOf(editor, buffers.Pos(editor.completion["line"], editor.completion["start"]));
        completion = {"x": start[0], "y": start[1] + editor.lineHeight, "items": editor.completion["items"],
            "selected": editor.completion["selected"], "itemHeight": editor.lineHeight + 2.0d};
    }
    var signature = null;
    if (editor.signature != null) { signature = {"x": caretPoint[0], "y": caretPoint[1] - editor.lineHeight - 4.0d, "label": editor.signature["label"], "documentation": editor.signature["documentation"]}; }
    return {
        "left": view.left, "top": view.top, "width": view.width, "height": view.height,
        "gutterWidth": gutter, "lineHeight": editor.lineHeight, "lines": lines,
        "caret": {"x": caretPoint[0], "y": caretPoint[1], "height": editor.lineHeight, "visible": CaretVisible(editor)},
        "composition": composition,
        "selections": selections, "diagnostics": marks, "completion": completion, "hover": editor.hover,
        "signature": signature, "menu": editor.menu, "verticalBar": ScrollView.VerticalBar(view),
        "horizontalBar": ScrollView.HorizontalBar(view), "theme": editor.theme, "focused": editor.focused
    };
};
